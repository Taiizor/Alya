let n = 120
let a = []
let b = []
let c = []

let i = 0
while i < n
    let j = 0
    while j < n
        a.push((i * 3 + j) % 10)
        b.push((i * 7 + j) % 10)
        c.push(0)
        j = j + 1
    end
    i = i + 1
end

i = 0
while i < n
    let j = 0
    while j < n
        let sum = 0
        let k = 0
        while k < n
            sum = sum + a[i * n + k] * b[k * n + j]
            k = k + 1
        end
        c[i * n + j] = sum
        j = j + 1
    end
    i = i + 1
end

let total = 0
let idx = 0
let total_cells = n * n
while idx < total_cells
    total = total + c[idx]
    idx = idx + 1
end

say total
