function mandelbrot_point(cr, ci, max_iter)
    let zr = 0.0
    let zi = 0.0
    let zr2 = 0.0
    let zi2 = 0.0
    let iter = 0
    while iter < max_iter
        zr2 = zr * zr
        zi2 = zi * zi
        if zr2 + zi2 > 4.0
            return iter
        end
        zi = 2.0 * zr * zi + ci
        zr = zr2 - zi2 + cr
        iter = iter + 1
    end
    return max_iter
end

function compute_grid(width, height, max_iter)
    let total = 0
    let y = 0
    let x = 0
    let ci = 0.0
    let cr = 0.0
    let iters = 0
    while y < height
        ci = -1.5 + (3.0 * y) / height
        x = 0
        while x < width
            cr = -2.0 + (3.0 * x) / width
            iters = mandelbrot_point(cr, ci, max_iter)
            total = total + iters
            x = x + 1
        end
        y = y + 1
    end
    return total
end

let total = compute_grid(200, 100, 200)
say total
