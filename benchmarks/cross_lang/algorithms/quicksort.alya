function partition(arr, low, high)
    let pivot = arr[high]
    let i = low - 1
    let j = low
    let temp = 0
    while j < high
        if arr[j] <= pivot
            i = i + 1
            temp = arr[i]
            arr[i] = arr[j]
            arr[j] = temp
        end
        j = j + 1
    end
    temp = arr[i + 1]
    arr[i + 1] = arr[high]
    arr[high] = temp
    return i + 1
end

function quicksort(arr, low, high)
    if low < high
        let pi = partition(arr, low, high)
        quicksort(arr, low, pi - 1)
        quicksort(arr, pi + 1, high)
    end
end

let arr = []
let seed = 42
let i = 0
let n = 50000
while i < n
    seed = (seed * 1103515245 + 12345) % 1000000
    if seed < 0
        seed = -seed
    end
    arr.push(seed)
    i = i + 1
end

quicksort(arr, 0, n - 1)

let checksum = arr[0] + arr[25000] + arr[n - 1]
say checksum
