function count_primes(limit)
    let flags = []
    let i = 0
    while i <= limit
        flags.push(1)
        i = i + 1
    end

    let p = 2
    while p * p <= limit
        if flags[p] == 1
            let multiple = p * p
            while multiple <= limit
                flags[multiple] = 0
                multiple = multiple + p
            end
        end
        p = p + 1
    end

    let count = 0
    let j = 2
    while j <= limit
        if flags[j] == 1
            count = count + 1
        end
        j = j + 1
    end
    return count
end

let primes = count_primes(50000)
say primes
