let m = map()
let n = 20000

let i = 0
while i < n
    let k = "key_" + i
    m[k] = i * 3
    i = i + 1
end

i = 0
while i < n
    if i % 2 == 0
        let k = "key_" + i
        m[k] = i * 5
    end
    i = i + 1
end

let sum = 0
i = 0
while i < n
    let k = "key_" + i
    sum = sum + m[k]
    i = i + 1
end

say sum
