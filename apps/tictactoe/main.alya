# ═══════════════════════════════════════════════════════════════
# TicTacToe - A classic game with PvP and AI modes
# Part of the Alya Apps Collection
# ═══════════════════════════════════════════════════════════════
#
# Features:
#   - Player vs Player (PvP) mode
#   - Player vs AI mode (unbeatable Minimax algorithm)
#   - ANSI colored game board
#   - Persistent score tracking across multiple rounds
#   - Robust input validation with error handling
#
# Controls:
#   Enter a number 1-9 to place your mark:
#     1 | 2 | 3
#     4 | 5 | 6
#     7 | 8 | 9
#
# Usage:
#   alyac run apps/tictactoe/main.alya
# ═══════════════════════════════════════════════════════════════

import "std/color"
import "std/console"
import "std/mem"

# ─── Score Tracking Struct ───────────────────────────────────

struct Scores
    p1
    p2
    draws
    rounds
end

# ─── String Persistence ─────────────────────────────────────
# Player names must survive the circular string buffer. We copy
# them into a small arena so they remain valid for the entire
# session regardless of how many temporary strings are created.

function persist_str(arena, s)
    if len(s) == 0
        return s
    end
    return arena_alloc_string(arena, s)
end

# ─── Display Functions ───────────────────────────────────────

function clear_screen()
    say "\e[2J\e[H"
end

function show_banner()
    let c = "\e[1;36m"
    let y = "\e[1;93m"
    let g = "\e[90m"
    let r = "\e[0m"
    say ""
    say c + "  ╔═══════════════════════════════╗" + r
    say c + "  ║" + y + "       T I C  T A C  T O E     " + c + "║" + r
    say c + "  ╠═══════════════════════════════╣" + r
    say c + "  ║" + g + "   Written in Alya Language    " + c + "║" + r
    say c + "  ╚═══════════════════════════════╝" + r
    say ""
end

function cell_display(val, pos)
    if val == 1
        return "\e[1;91m X \e[0m"
    elif val == 2
        return "\e[1;94m O \e[0m"
    end
    return "\e[90m " + str(pos) + " \e[0m"
end

function draw_board(board)
    let c = "\e[36m"
    let r = "\e[0m"
    say c + "    ┌───┬───┬───┐" + r
    say c + "    │" + r + cell_display(board[0], 1) + c + "│" + r + cell_display(board[1], 2) + c + "│" + r + cell_display(board[2], 3) + c + "│" + r
    say c + "    ├───┼───┼───┤" + r
    say c + "    │" + r + cell_display(board[3], 4) + c + "│" + r + cell_display(board[4], 5) + c + "│" + r + cell_display(board[5], 6) + c + "│" + r
    say c + "    ├───┼───┼───┤" + r
    say c + "    │" + r + cell_display(board[6], 7) + c + "│" + r + cell_display(board[7], 8) + c + "│" + r + cell_display(board[8], 9) + c + "│" + r
    say c + "    └───┴───┴───┘" + r
    say ""
end

function show_scores(n1, n2, sc)
    let c = "\e[1;36m"
    let r = "\e[0m"
    let b = "\e[1m"
    say c + "  ═══════ SCOREBOARD ════════" + r
    say "    \e[1;91m" + n1 + " (X)\e[0m : " + b + str(sc.p1) + r
    say "    \e[1;94m" + n2 + " (O)\e[0m : " + b + str(sc.p2) + r
    say "    \e[90mDraws\e[0m    : " + b + str(sc.draws) + r
    say "    \e[90mRounds\e[0m   : " + b + str(sc.rounds) + r
    say c + "  ══════════════════════════════" + r
    say ""
end

# ─── Game Logic ──────────────────────────────────────────────

function check_winner(board)
    # Rows
    if board[0] != 0 and board[0] == board[1] and board[1] == board[2]
        return board[0]
    end
    if board[3] != 0 and board[3] == board[4] and board[4] == board[5]
        return board[3]
    end
    if board[6] != 0 and board[6] == board[7] and board[7] == board[8]
        return board[6]
    end

    # Columns
    if board[0] != 0 and board[0] == board[3] and board[3] == board[6]
        return board[0]
    end
    if board[1] != 0 and board[1] == board[4] and board[4] == board[7]
        return board[1]
    end
    if board[2] != 0 and board[2] == board[5] and board[5] == board[8]
        return board[2]
    end

    # Diagonals
    if board[0] != 0 and board[0] == board[4] and board[4] == board[8]
        return board[0]
    end
    if board[2] != 0 and board[2] == board[4] and board[4] == board[6]
        return board[2]
    end

    return 0
end

function is_board_full(board)
    for i in 0..8
        if board[i] == 0
            return 0
        end
    end
    return 1
end

# ─── AI Engine (Minimax Algorithm) ───────────────────────────

function minimax(board, is_maximizing)
    let winner = check_winner(board)
    if winner == 1
        return -10
    end
    if winner == 2
        return 10
    end
    if is_board_full(board) == 1
        return 0
    end

    if is_maximizing == 1
        let best = -100
        let i = 0
        while i < 9
            if board[i] == 0
                board[i] = 2
                let s = minimax(board, 0)
                board[i] = 0
                if s > best
                    best = s
                end
            end
            i += 1
        end
        return best
    end

    let best = 100
    let i = 0
    while i < 9
        if board[i] == 0
            board[i] = 1
            let s = minimax(board, 1)
            board[i] = 0
            if s < best
                best = s
            end
        end
        i += 1
    end
    return best
end

function ai_best_move(board)
    let best_score = -100
    let best_pos = 0
    let i = 0
    while i < 9
        if board[i] == 0
            board[i] = 2
            let s = minimax(board, 0)
            board[i] = 0
            if s > best_score
                best_score = s
                best_pos = i
            end
        end
        i += 1
    end
    return best_pos
end

# ─── Player Input ────────────────────────────────────────────

function get_move(board, name, mark)
    let mark_str = "X"
    if mark == 2
        mark_str = "O"
    end

    repeat
        let input = ask "    " + name + " (" + mark_str + ") -> Position (1-9): "
        let choice = trim(input)

        try
            let pos = int(choice)
            if pos >= 1 and pos <= 9
                if board[pos - 1] == 0
                    return pos - 1
                end
                say color_yellow("    ! Position already taken. Choose another.")
            else
                say color_yellow("    ! Please enter a number between 1 and 9.")
            end
        catch err
            say color_yellow("    ! Invalid input. Please enter a number.")
        end
    end
end

# ═══════════════════════════════════════════════════════════════
#                        MAIN GAME
# ═══════════════════════════════════════════════════════════════

# Initialize console with UTF-8 encoding
console_utf8()

clear_screen()
show_banner()

# --- Persistent string arena for player names ---
let str_arena = arena_new(4096)

# --- Player Setup ---

say color_bright_cyan("  Welcome to TicTacToe!")
say ""

let p1_raw = ask "  Enter Player 1 name: "
let name1 = trim(p1_raw)
if len(name1) > 0
    name1 = persist_str(str_arena, name1)
else
    name1 = "Player 1"
end

say ""
say "  " + color_bright_green("[1]") + " Player vs Player (PvP)"
say "  " + color_bright_green("[2]") + " Player vs AI"
say ""

let mode_raw = ask "  Choose mode (1/2): "
let mode = trim(mode_raw)

let is_ai = 0
let name2 = "Player 2"

if mode == "2"
    is_ai = 1
    name2 = "Alya AI"
    say ""
    say color_bright_magenta("  You will face the unbeatable Alya AI! Good luck!")
    sleep(1500)
else
    say ""
    let p2_raw = ask "  Enter Player 2 name: "
    name2 = trim(p2_raw)
    if len(name2) > 0
        name2 = persist_str(str_arena, name2)
    else
        name2 = "Player 2"
    end
end

# --- Score Tracking ---

let scores = Scores(0, 0, 0, 0)

# --- Main Game Loop ---

let playing = 1

while playing == 1
    scores.rounds += 1
    let board = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    let current = 1
    let game_over = 0

    # --- Round Loop ---
    while game_over == 0
        clear_screen()
        show_banner()
        show_scores(name1, name2, scores)
        draw_board(board)

        if current == 2 and is_ai == 1
            # AI turn
            say color_bright_magenta("    Alya AI is thinking...")
            sleep(700)
            let ai_pos = ai_best_move(board)
            board[ai_pos] = 2
        else
            # Human turn
            let current_name = name1
            if current == 2
                current_name = name2
            end
            let move = get_move(board, current_name, current)
            board[move] = current
        end

        # Check game result
        let winner = check_winner(board)
        if winner != 0
            game_over = 1
        elif is_board_full(board) == 1
            game_over = 1
        else
            if current == 1
                current = 2
            else
                current = 1
            end
        end
    end

    # --- Show Round Result ---
    clear_screen()
    show_banner()
    draw_board(board)

    let result = check_winner(board)
    if result == 1
        scores.p1 += 1
        say "\e[1;92m    " + name1 + " (X) wins! Congratulations!\e[0m"
    elif result == 2
        scores.p2 += 1
        say "\e[1;92m    " + name2 + " (O) wins! Congratulations!\e[0m"
    else
        scores.draws += 1
        say "\e[1;93m    It's a draw! Well played!\e[0m"
    end

    say ""
    show_scores(name1, name2, scores)

    let again_raw = ask "  Play again? (y/n): "
    let again = lower(trim(again_raw))
    if again != "y" and again != "yes"
        playing = 0
    end
end

# --- Goodbye ---

say ""
show_scores(name1, name2, scores)
say color_bright_cyan("  Thanks for playing TicTacToe!")
say color_gray("  See you next time!")
say ""

# Free persistent string arena
arena_free(str_arena)
