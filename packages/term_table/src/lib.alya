# ═══════════════════════════════════════════════════════════════
# term_table Library (term_table)
# Reusable Alya Package for Terminal Tables & UI Badges
# ═══════════════════════════════════════════════════════════════

import "std/str"
import "std/color"

function cell(text, width)
    let s = str(text)
    if len(s) > width
        if width > 3
            return substring(s, 0, width - 3) + "..."
        else
            return substring(s, 0, width)
        end
    end
    return pad_right(s, width, " ")
end

function box_top(w1, w2, w3, w4, w5)
    return "┌" + str_repeat("─", w1 + 2) + "┬" + str_repeat("─", w2 + 2) + "┬" + str_repeat("─", w3 + 2) + "┬" + str_repeat("─", w4 + 2) + "┬" + str_repeat("─", w5 + 2) + "┐"
end

function box_mid(w1, w2, w3, w4, w5)
    return "├" + str_repeat("─", w1 + 2) + "┼" + str_repeat("─", w2 + 2) + "┼" + str_repeat("─", w3 + 2) + "┼" + str_repeat("─", w4 + 2) + "┼" + str_repeat("─", w5 + 2) + "┤"
end

function box_bot(w1, w2, w3, w4, w5)
    return "└" + str_repeat("─", w1 + 2) + "┴" + str_repeat("─", w2 + 2) + "┴" + str_repeat("─", w3 + 2) + "┴" + str_repeat("─", w4 + 2) + "┴" + str_repeat("─", w5 + 2) + "┘"
end

function row(c1, c2, c3, c4, c5)
    return "│ " + c1 + " │ " + c2 + " │ " + c3 + " │ " + c4 + " │ " + c5 + " │"
end

function badge(text, color_name)
    when color_name
        is "red" then return style_bold(color_red(text))
        is "green" then return color_green(text)
        is "yellow" then return color_yellow(text)
        is "cyan" then return color_cyan(text)
        is "magenta" then return color_magenta(text)
        is "gray" then return color_gray(text)
        else return text
    end
end
