# Arithmetic operations in Alya
# Demonstrates basic math operations (+, -, *, /, %) and expression precedence

let a = 20
let b = 6

let sum = a + b
let diff = a - b
let prod = a * b
let quot = a / b
let rem = a % b
let expr = (a + b) * 2

say "=== Basic Arithmetic ==="
say "{a} + {b} = {sum}"
say "{a} - {b} = {diff}"
say "{a} * {b} = {prod}"
say "{a} / {b} = {quot}"
say "{a} % {b} = {rem}"

say "\n=== Expression Precedence ==="
say "({a} + {b}) * 2 = {expr}"
