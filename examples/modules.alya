# Demonstrates modular multi-file imports from subdirectories
import "modules/math_utils.alya"

say "=== Modules & Imports ==="

let x, y = 12, 4

let sum = add(x, y)
say "Sum: {sum}"

let product = multiply(x, y)
say "Product: {product}"

let sq = square(x)
say "Square of 12: {sq}"

# Function call inside string interpolation
say "Inline call: {add(1, 1)}"