# Conditionals in Alya
# Demonstrates if, elif, else, and logical operators (&&, ||, !)

let score, attendance = 85, 92
let has_recommendation = false

say "=== Academic Evaluation ==="
say "Score:      {score}"
say "Attendance: {attendance}%"

# 1. if / elif / else branching
if score >= 90
    say "Result: Grade A - Excellent!"
elif score >= 75
    say "Result: Grade B - Good job!"
elif score >= 50
    say "Result: Grade C - Passed"
else
    say "Result: Need improvement"
end

# 2. Logical operators (&&, ||, !)
if (score >= 80) && (attendance >= 90)
    say "Status: Eligible for honors"
else
    say "Status: Regular standing"
end

if has_recommendation || score >= 85
    say "Award:  Scholarship considered"
end
