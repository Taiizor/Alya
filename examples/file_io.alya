# File Input/Output in Alya

let path = "target/demo_file.txt"

say "=== File Existence ==="
let exists1 = file_exists(path)
say "Exists before writing: {exists1}"

say "\n=== Writing File ==="
let content = "Hello from Alya File I/O!\nBuilding compilers with self-hosting."
let written = write_file(path, content)
say "Write successful: {written}"
let exists2 = file_exists(path)
say "Exists after writing: {exists2}"

say "\n=== Reading File ==="
let read_back = read_file(path)
say read_back

say "=== Deleting File ==="
let deleted = delete_file(path)
say "Delete successful: {deleted}"
let exists3 = file_exists(path)
say "Exists after deleting: {exists3}"
