# Loops in Alya
# Demonstrates for loops, while loops, repeat loops, compound assignments, and break

# 1. For loop (bounded range)
say "=== For Loop (Range 1..5) ==="
for i in 1..5
    say "Iteration {i}"
end

# 2. While loop (condition-controlled)
say "\n=== While Loop with += ==="
let count = 0
while count < 4
    count += 1
    say "Count: {count}"
end

# 3. While loop with early break
say "\n=== While Loop with Break ==="
let w = 1
while w <= 10
    if w > 3
        say "While broke early at w = {w}"
        break
    end
    say "While item: {w}"
    w += 1
end

# 4. Repeat loop (unconditional loop with exit condition)
say "\n=== Repeat Loop with Break ==="
let r = 1
repeat
    if r > 3
        say "Repeat broke at r = {r}"
        break
    end
    say "Repeat item: {r}"
    r += 1
end

# 5. Loop with continue (skipping iterations)
say "\n=== Loop with Continue ==="
for num in 1..6
    if num % 2 == 0
        continue
    end
    say "Odd number: {num}"
end

# 6. For-each loop (array iteration)
say "\n=== For-Each Array Iteration ==="
let fruits = ["apple", "banana", "cherry"]
for f in fruits
    say "Fruit: {f}"
end


