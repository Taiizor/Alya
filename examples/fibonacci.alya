# Fibonacci sequence in Alya
# Demonstrates loops, variables, and arithmetic expressions

say "=== Fibonacci Sequence in Alya ==="

say "Computing first 10 Fibonacci numbers with a loop:"

let a, b = 0, 1
let temp = 0

for i in 1..10
    say a
    temp = a + b
    a = b
    b = temp
end

say "\nStep-by-step recurrence demonstration:"
let f5 = 3 + 2
say "F(5) = F(4) + F(3) = 3 + 2 = {f5}"

let f6 = 5 + 3
say "F(6) = F(5) + F(4) = 5 + 3 = {f6}"

let f7 = 8 + 5
say "F(7) = F(6) + F(5) = 8 + 5 = {f7}"

let f8 = 13 + 8
say "F(8) = F(7) + F(6) = 13 + 8 = {f8}"
