# Variables in Alya
# Demonstrates variable declaration, string interpolation, and mutability

# 1. Variable declarations
let name = "Alya"
let version, year = 1, 2026
let is_open_source = true

say "=== Language Information ==="
say "Language:    {name}"
say "Version:     {version}"
say "Year:        {year}"
say "Open Source: {is_open_source}"

# 2. Variable reassignment and expressions
let next_version = version + 1
say "Next version will be: {next_version}"

let age_years = 2026 - 2024
say "Project age: {age_years} years"
