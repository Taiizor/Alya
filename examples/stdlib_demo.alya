# Alya Standard Library Demonstration
# Demonstrates math, time, os, and json modules.

import "std/math"
import "std/time"
import "std/os"
import "std/json"

say "=== 1. Testing std/math ==="
say "PI is:"
say PI
let deg = 180.0
let rad = deg_to_rad(deg)
say "180 degrees in radians:"
say rad
say "Back to degrees:"
say rad_to_deg(rad)
say "Clamp 15 between 1 and 10:"
say clamp(15, 1, 10)
say "Hypotenuse of 3 and 4:"
say hypot(3, 4)
say "Is 42 even?"
say is_even(42)

say "\n=== 2. Testing std/time ==="
let t = now()
say "Current epoch time > 0:"
if t > 0
    say 1
else
    say 0
end
say "Sleeping for 10ms..."
delay(10)
say "Sleep finished!"

say "\n=== 3. Testing std/os ==="
let path_var = env("PATH")
if len(path_var) > 0
    say "PATH environment variable is present: 1"
else
    say "PATH environment variable is present: 0"
end

say "\n=== 4. Testing std/json ==="
say "JSON number:"
say json_number(123)
say "JSON string:"
say json_string("hello")
say "JSON boolean:"
say json_bool(1)
say "JSON array:"
let arr = ["1", "2", "3"]
say json_array(arr)
say "\nAll Standard Library modules executed successfully!"
