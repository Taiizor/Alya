# Alya Standard Library - Glob Demo
# Demonstrates pattern matching, character classes, recursive globbing,
# list filtering, escaping, and filesystem directory globbing.

import "std/glob"

say "=== Alya std/glob Demo ==="

# 1. Basic Wildcards (* and ?)
say "\n--- 1. Basic Wildcards ---"
say "*.alya matches main.alya: " + str(glob_match("*.alya", "main.alya"))
say "*.alya matches main.rs: " + str(glob_match("*.alya", "main.rs"))
say "file_?.txt matches file_1.txt: " + str(glob_match("file_?.txt", "file_1.txt"))
say "file_?.txt matches file_10.txt: " + str(glob_match("file_?.txt", "file_10.txt"))

# 2. Path-aware and Recursive Globbing (**)
say "\n--- 2. Path-aware and Recursive Matching ---"
say "src/*.rs matches src/main.rs: " + str(glob_match("src/*.rs", "src/main.rs"))
say "src/*.rs matches src/codegen/expr.rs: " + str(glob_match("src/*.rs", "src/codegen/expr.rs"))
say "src/**/*.rs matches src/codegen/expr.rs: " + str(glob_match("src/**/*.rs", "src/codegen/expr.rs"))
say "**/*.alya matches stdlib/glob.alya: " + str(glob_match("**/*.alya", "stdlib/glob.alya"))

# 3. Character Classes and Ranges
say "\n--- 3. Character Classes ---"
say "file_[0-9].log matches file_3.log: " + str(glob_match("file_[0-9].log", "file_3.log"))
say "file_[0-9].log matches file_a.log: " + str(glob_match("file_[0-9].log", "file_a.log"))
say "doc_[!0-9].txt matches doc_x.txt: " + str(glob_match("doc_[!0-9].txt", "doc_x.txt"))
say "doc_[!0-9].txt matches doc_1.txt: " + str(glob_match("doc_[!0-9].txt", "doc_1.txt"))

# 4. Pattern Inspection and Escaping
say "\n--- 4. Pattern Inspection & Escaping ---"
say "is_pattern('src/**/*.rs'): " + str(glob_is_pattern("src/**/*.rs"))
say "is_pattern('plain_file.txt'): " + str(glob_is_pattern("plain_file.txt"))
let pattern_str = "price_[0-9]*"
let escaped = glob_escape(pattern_str)
say "Escaped pattern: " + escaped

# 5. Filtering In-Memory Lists
say "\n--- 5. Filtering Lists ---"
let files = ["app.alya", "config.json", "data.csv", "runner.alya", "readme.md"]
let alya_files = glob_filter("*.alya", files)
say "Filtered .alya files count: " + str(array_len(alya_files))
let i = 0
while i < array_len(alya_files)
    say "  Matched: " + str_from_ptr(alya_files[i])
    i += 1
end

# 6. Filesystem Directory Globbing
say "\n--- 6. Filesystem Globbing ---"
let stdlib_matches = glob_dir("*csv*", "stdlib")
say "Found *csv* files in stdlib: " + str(array_len(stdlib_matches) > 0)

say "\nstd/glob demo completed successfully."
