# Alya Advanced Memory Management & Arena Allocator Demonstration

import "std/mem"

say "=== 1. Testing Raw Memory Allocation & Pointer Access ==="
let buf = alloc(64)
say "Allocated 64 bytes."

# Write and read bytes
poke_byte(buf, 0, 72)   # 'H'
poke_byte(buf, 1, 101)  # 'e'
poke_byte(buf, 2, 108)  # 'l'
poke_byte(buf, 3, 108)  # 'l'
poke_byte(buf, 4, 111)  # 'o'
poke_byte(buf, 5, 0)    # null terminator

say "Peek byte 0 (ascii):"
say peek_byte(buf, 0)
say "Peek byte 1 (ascii):"
say peek_byte(buf, 1)

# Convert raw buffer to string
say "String from raw pointer:"
say str_from_ptr(buf)

# Test 64-bit integer peek and poke
poke_int(buf, 8, 987654321)
say "Peek int at offset 8:"
say peek_int(buf, 8)

# Memory copy
let dest = alloc(64)
copy_mem(dest, buf, 64)
say "Copied string from dest:"
say str_from_ptr(dest)
say "Copied int from dest offset 8:"
say peek_int(dest, 8)

# Zero memory
zero_mem(dest, 64)
say "Byte after zero_mem:"
say peek_byte(dest, 0)

free(buf)
free(dest)
say "Raw buffers successfully freed!"

say "\n=== 2. Testing High-Performance Arena Allocator ==="
# Create arena with 1024-byte chunk size
let arena = arena_new(1024)

let block1 = arena_alloc_mem(arena, 32)
poke_byte(block1, 0, 65) # 'A'
poke_byte(block1, 1, 108) # 'l'
poke_byte(block1, 2, 121) # 'y'
poke_byte(block1, 3, 97) # 'a'
poke_byte(block1, 4, 0)

let block2 = arena_alloc_mem(arena, 48)
poke_int(block2, 0, 2026)

say "Block 1 string:"
say str_from_ptr(block1)
say "Block 2 int value:"
say peek_int(block2, 0)

say "Total bytes allocated in arena:"
say arena_total_allocated(arena)

# Reset arena (O(1) bulk reclaim without deallocating chunks)
arena_clear(arena)
say "Total bytes allocated after reset:"
say arena_total_allocated(arena)

# Re-allocate after reset
let block3 = arena_alloc_mem(arena, 16)
poke_byte(block3, 0, 90) # 'Z'
poke_byte(block3, 1, 0)
say "Re-allocated block string:"
say str_from_ptr(block3)

# Destroy arena and release all OS chunks
arena_free_all(arena)
say "Arena successfully destroyed!"

say "\nAdvanced Memory Management demonstration finished successfully!"
