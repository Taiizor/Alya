# Functions in Alya
# Demonstrates function definitions, parameters, return values, and interpolation

# 1. Procedure without return value
function greet(name)
    say "Hello, {name}! Welcome to Alya."
end

# 2. Function returning a computed value
function rectangle_area(width, height)
    return width * height
end

# 3. Function with multiple parameters and arithmetic
function calculate_total(price, quantity, discount)
    let subtotal = price * quantity
    return subtotal - discount
end

say "=== Functions Demo ==="

# Calling procedure
greet("Developer")

# Calling functions with return values
let area = rectangle_area(8, 5)
say "Area of 8x5 rectangle: {area}"

let total = calculate_total(25, 4, 10)
say "Total after discount:  ${total}"
