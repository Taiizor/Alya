import "std/rand"

say "=== Alya std/rand Demo ==="

# 1. Random Numbers & Floats (Auto-seeded by runtime)
say "\n--- 1. Basic Generation ---"
say "rand_int(1, 100): " + str(rand_int(1, 100))
let rf = rand_float()
say "rand_float()    : {rf}"
say "rand_bool()     : " + str(rand_bool())
say "rand_chance(75) : " + str(rand_chance(75))

# 2. Basic Array Operations
say "\n--- 2. Array Choice ---"
let fruits = ["Apple", "Banana", "Cherry", "Mango", "Orange"]
say "Random choice : " + rand_choice(fruits)

# 3. Reproducible Deterministic Generation (Fixed Seed)
say "\n--- 3. Reproducible Generation (Fixed Seed=42) ---"
rand_seed(42)
let det1 = rand_int(1, 100)
rand_seed(42)
let det2 = rand_int(1, 100)
say "Same seed produces same value: " + str(det1 == det2) + " (" + str(det1) + " == " + str(det2) + ")"

# 4. Advanced Production Requirements
say "\n--- 4. Advanced Production Packages ---"
say "Tip: For UUID v4, UUID v7, ULID, and NanoID, use:"
say "  alyac add uuid --git https://github.com/alya-lang/uuid --branch main"
say "Tip: For statistical distributions, sampling, strings, and custom engines:"
say "  alyac add rand --git https://github.com/alya-lang/rand --branch main"
say "std/rand demo completed successfully."
