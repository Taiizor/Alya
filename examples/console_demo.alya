import "std/console"

say "=== Alya std/console Demo ==="

# 1. Encoding & Code Page Management
say "\n--- 1. Encoding & Code Page ---"
console_utf8()
say "Current Output Encoding: " + get_output_encoding()
say "Output Code Page: " + str(console_output_cp())
say "Input Code Page: " + str(console_input_cp())

# 2. Unicode Box-Drawing & Turkish Characters
say "\n--- 2. Unicode Box-Drawing & UTF-8 ---"
say "┌────────────────────────────────────────┐"
say "│     Alya Cross-Platform Console        │"
say "├────────────────────────────────────────┤"
say "│  ╔══════════════════════════════════╗  │"
say "│  ║ Türkçe: Çavdar, Yağmur, Şömine   ║  │"
say "│  ║ Unicode: ★ ♠ ♣ ♥ ♦ ➜ ✦ ❖         ║  │"
say "│  ╚══════════════════════════════════╝  │"
say "└────────────────────────────────────────┘"

# 3. Terminal Control Capabilities
say "\n--- 3. Terminal Control Capabilities ---"
console_enable_ansi()
say "ANSI escape sequences and Virtual Terminal processing are enabled."
say "Available utilities:"
say "  - console_utf8() / set_output_encoding(\"UTF-8\")"
say "  - console_clear() / console_title(\"My App\")"
say "  - console_cursor_to(row, col) / console_cursor_hide() / console_cursor_show()"

say "\nstd/console demo completed successfully."
