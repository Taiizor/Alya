# Alya Standard Library Comprehensive Showcase
# Demonstrates all new stdlib packages: str, path, fs, math, hash, collections, json, and test.

import "std/str"
import "std/path"
import "std/fs"
import "std/math"
import "std/hash"
import "std/collections"
import "std/json"
import "std/test"

test_suite("Alya Extended Standard Library")

# 1. String Utilities (std/str)
assert_eq(starts_with("hello world", "hello"), 1, "starts_with prefix match")
assert_eq(starts_with("hello world", "world"), 0, "starts_with non-match")
assert_eq(ends_with("archive.tar.gz", ".gz"), 1, "ends_with suffix match")
assert_str_eq(replace("apple orange banana", "orange", "grape"), "apple grape banana", "replace substring")
assert_str_eq(str_repeat("Alya", 3), "AlyaAlyaAlya", "str_repeat string")
assert_str_eq(pad_left("42", 5, "0"), "00042", "pad_left zeros")
assert_str_eq(pad_right("Item", 8, "."), "Item....", "pad_right dots")
assert_str_eq(capitalize("alya"), "Alya", "capitalize string")
assert_eq(count_matches("banana", "a"), 3, "count_matches single char")
assert_eq(is_empty(""), 1, "is_empty on empty string")
assert_eq(is_empty("not empty"), 0, "is_empty on non-empty string")

let line_arr = lines("First\nSecond\nThird")
assert_eq(len(line_arr), 3, "lines length")
assert_str_eq(line_arr[0], "First", "lines first item")
assert_str_eq(line_arr[2], "Third", "lines third item")

# 2. Path Utilities (std/path)
let joined = path_join("usr/local", "bin/alyac")
assert_str_eq(joined, "usr/local/bin/alyac", "path_join normal")
assert_str_eq(file_name("src/compiler/main.alya"), "main.alya", "file_name")
assert_str_eq(file_ext("src/compiler/main.alya"), ".alya", "file_ext")
assert_str_eq(file_stem("src/compiler/main.alya"), "main", "file_stem")
assert_str_eq(parent_dir("src/compiler/main.alya"), "src/compiler", "parent_dir")
assert_eq(is_absolute("/etc/alya/config"), 1, "is_absolute unix root")

# 3. Math & Statistics (std/math)
assert_eq(floor(3.7), 3, "floor positive")
assert_eq(ceil(3.2), 4, "ceil positive")
assert_eq(trunc(5.8), 5, "trunc positive")

# Test sin/cos around known angles (sin(0) == 0, cos(0) == 1)
let s0 = sin(0.0)
let c0 = cos(0.0)
assert_eq(round(s0), 0, "sin(0) is 0")
assert_eq(round(c0), 1, "cos(0) is 1")

rand_seed(42)
let r1 = rand_range(10, 20)
assert_true(r1 >= 10 and r1 <= 20, "rand_range bounds")

let numbers = [10, 20, 30, 40, 50]
assert_eq(sum(numbers), 150, "sum of numbers")
assert_eq(round(mean(numbers)), 30, "mean of numbers")
assert_eq(median(numbers), 30, "median of numbers")

# 4. Hash & Encoding (std/hash)
let d1 = djb2("hello")
let d2 = djb2("hello")
let d3 = djb2("world")
assert_eq(d1, d2, "djb2 deterministic")
assert_ne(d1, d3, "djb2 distinct")

let f1 = fnv1a("test")
let f2 = fnv1a("test")
assert_eq(f1, f2, "fnv1a deterministic")

let hex_s = hex_encode("Hi")
assert_str_eq(hex_s, "4869", "hex_encode 'Hi'")
assert_str_eq(hex_decode("4869"), "Hi", "hex_decode '4869'")

let b64_s = base64_encode("Alya")
assert_str_eq(b64_s, "QWx5YQ==", "base64_encode 'Alya'")
assert_str_eq(base64_decode("QWx5YQ=="), "Alya", "base64_decode 'QWx5YQ=='")

# 5. Collections (std/collections)
# Stack
let st = stack_new()
stack_push(st, 100)
stack_push(st, 200)
assert_eq(stack_size(st), 2, "stack size is 2")
assert_eq(stack_peek(st), 200, "stack peek top")
assert_eq(stack_pop(st), 200, "stack pop top")
assert_eq(stack_pop(st), 100, "stack pop last")
assert_eq(stack_is_empty(st), 1, "stack is empty")

# Queue
let q = queue_new()
queue_push(q, "first")
queue_push(q, "second")
assert_eq(queue_size(q), 2, "queue size is 2")
assert_str_eq(queue_peek(q), "first", "queue peek FIFO")
assert_str_eq(queue_pop(q), "first", "queue pop FIFO")
assert_str_eq(queue_pop(q), "second", "queue pop next")
assert_eq(queue_is_empty(q), 1, "queue is empty")

# Set
let my_set = set_new()
set_add(my_set, "alpha")
set_add(my_set, "beta")
set_add(my_set, "alpha")
assert_eq(set_has(my_set, "alpha"), 1, "set has alpha")
assert_eq(set_has(my_set, "gamma"), 0, "set does not have gamma")
assert_eq(set_size(my_set), 2, "set size deduplicated")
set_remove(my_set, "alpha")
assert_eq(set_has(my_set, "alpha"), 0, "set remove alpha")

# 6. JSON Object (std/json)
let user_map = map()
user_map["role"] = "dev"
user_map["lang"] = "alya"
let j_obj = json_object(user_map)
assert_true(len(j_obj) > 10, "json_object serializes map")

# 7. Filesystem (std/fs)
let test_file = "scratch_test_fs.txt"
fs_write(test_file, "Hello ")
fs_append(test_file, "Alya!")
assert_eq(fs_exists(test_file), 1, "fs_exists after write")
assert_str_eq(fs_read(test_file), "Hello Alya!", "fs_read matches written content")
assert_eq(fs_size(test_file), 11, "fs_size is 11 bytes")

let copy_target = "scratch_test_copy.txt"
copy_file(test_file, copy_target)
assert_str_eq(fs_read(copy_target), "Hello Alya!", "copy_file copied content")

fs_remove(test_file)
fs_remove(copy_target)
assert_eq(fs_exists(test_file), 0, "fs_remove cleaned up original")
assert_eq(fs_exists(copy_target), 0, "fs_remove cleaned up copy")

let failed = test_summary()
say "Test suite finished with code: {failed}"
