# Standard library built-in functions

# 1. len(str) - returns string length
let text = "Hello, Alya!"
let length = len(text)
say "Length: {length}"

# 2. abs(num) - returns absolute value
let diff = abs(-25)
say "Absolute value: {diff}"

# 3. min(a, b) and max(a, b)
let lower = min(15, 42)
let higher = max(15, 42)
say "Min: {lower}"
say "Max: {higher}"
