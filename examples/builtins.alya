# Standard library built-in functions

# 1. len(str) - returns string length
let text = "Hello, Alya!"
let length = len(text)
say "Length: {length}"

# 2. abs(num) - returns absolute value
let diff = abs(-25)
say "Absolute value: {diff}"

# 3. min(a, b) and max(a, b)
let lower_val = min(15, 42)
let higher_val = max(15, 42)
say "Min: {lower_val}"
say "Max: {higher_val}"

# 4. sqrt(num) - returns integer square root
let root = sqrt(64)
say "Square root of 64: {root}"

# 5. pow(base, exp) - returns integer exponentiation
let power = pow(2, 10)
say "2 to the power of 10: {power}"

# 6. String helpers: trim, upper, lower, contains, substring
let raw = "   Alya Programming Language   "
let clean = raw.trim()
say "Trimmed: " + clean

let upper_str = clean.upper()
say "Uppercase: " + upper_str

let lower_str = clean.lower()
say "Lowercase: " + lower_str

let has_word = clean.contains("Language")
say "Contains 'Language': {has_word}"

let part = clean.substring(0, 4)
say "Substring: " + part

# 7. String split and join
let parts = "apple,banana,orange".split(",")
say "Split count: {parts.len()}"
let rejoined = parts.join(" - ")
say "Joined: " + rejoined


