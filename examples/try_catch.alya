# Error Handling with try-catch in Alya

say "=== Try-Catch Demo ==="

# 1. Basic try-catch block
say "\n1. Basic try-catch:"
try
    say "Attempting division..."
    let result = 100 / 0
    say "Result: {result}"
catch
    say "Caught error: Division by zero was safely handled!"
end

# 2. Try-catch with error variable
say "\n2. Try-catch with error message:"
try
    say "Calculating modulo..."
    let rem = 50 % 0
    say "Remainder: {rem}"
catch err
    say "Caught exception message: {err}"
end

# 3. Successful try block (no error)
say "\n3. Successful try block:"
try
    let safe = 100 / 4
    say "Safe division result: {safe}"
catch
    say "This should not run!"
end

say "\nProgram completed successfully without crashing."
