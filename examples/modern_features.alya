// Modern Features in Alya
/*
   Showcasing:
   - C-style comments
   - Compound assignment operators
   - Logical operators (&&, ||, !)
   - Chained elif branching
   - Multi-variable let declarations (let a, b = 0, let x, y = 1, 2)
   - Built-in functions (len, abs, min, max)
*/

// 1. Compound assignment operators
let score = 100
score += 25
score -= 10
score *= 2
score /= 5
say "Calculated score: {score}"

// 2. Chained elif and logical operators
let age, has_id = 22, true

if (age >= 18) && has_id
    say "Access granted!"
elif (age >= 18) && !has_id
    say "ID required."
else
    say "Underage."
end

// 3. Built-in functions
let greeting = "Hello, World!"
let l = len(greeting)
say "Length of greeting: {l}"

let a = abs(-42)
say "Absolute value of -42: {a}"

let mn = min(10, 20)
say "Minimum of 10 and 20: {mn}"

let mx = max(10, 20)
say "Maximum of 10 and 20: {mx}"

