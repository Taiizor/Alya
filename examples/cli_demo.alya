# CLI Module Demonstration (std/cli)
# Demonstrates lightweight OS argument accessors and flag/option helpers.
# For advanced CLI parsing (subcommands, choice validation, auto-generated
# help screens, flag clustering), use the modern 'alya-lang/cli' package.

import "std/cli"

say "=== 1. OS Argument Accessors ==="
let raw = cli_raw_args()
say "Raw argument count: " + str(cli_arg_count())

let i = 0
while i < cli_arg_count()
    say "  [" + str(i) + "]: " + cli_arg_at(i)
    i += 1
end

say "=== 2. Lightweight Flag & Option Detection ==="
say "Has --help / -h      : " + str(cli_has_flag("help"))
say "Has --verbose / -v   : " + str(cli_has_flag("verbose"))
say "Option --config / -c : " + cli_get_opt("config", "default.toml")
say "Positional Arg #0    : " + cli_get_positional(0, "<none>")

say "=== 3. Modern Package Recommendation ==="
say "For subcommands, command aliases, and automated help screens:"
say "  alyac add cli --git https://github.com/alya-lang/cli --tag v0.1.0"
say "  alyac install"
say "CLI demo completed successfully."
