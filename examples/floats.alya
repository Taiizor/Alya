# Floating-Point Numbers in Alya
# Demonstrates float literals, arithmetic, type conversions, and formatting

say "=== Floating-Point Operations ==="

# 1. Float declarations
let pi, radius = 3.14159, 2.5

# 2. Arithmetic calculations
let circumference = 2.0 * pi * radius
let area = pi * radius * radius

say "Radius: {radius}"
say "Circumference: {circumference}"
say "Area: {area}"

# 3. Mixed integer and floating-point arithmetic
let count = 4
let average = (10.0 + 20.0 + 30.5 + 40.5) / float(count)
say "Average: {average}"

# 4. Type conversions (float and int)
let int_val = 42
let to_float = float(int_val) + 0.5
let back_to_int = int(to_float)

say "Converted to float: {to_float}"
say "Converted back to int: {back_to_int}"

# 5. Compound assignment with floats
let score = 10.5
score += 4.5
score *= 2.0
say "Final score: {score}"
