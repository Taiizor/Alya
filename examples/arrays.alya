# Arrays and Indexing in Alya
# Demonstrates array creation, length, indexing, mutation, traversal, and bounds protection

# 1. Array creation and printing
let numbers = [10, 20, 30, 40]
say "Initial array:"
say numbers

# 2. Array length
let total = len(numbers)
say "Array length: {total}"

# 3. Element access (read)
let first = numbers[0]
let second = numbers[1]
say "First element: {first}"
say "Second element: {second}"

# 4. Element mutation (write & compound assignment)
numbers[2] = 99
numbers[0] += 5
say "Mutated array:"
say numbers

# 5. Dynamic methods: push and pop
numbers.push(50)
push(numbers, 60)
say "After push operations:"
say numbers
let popped = numbers.pop()
say "Popped element: {popped}"
say "After pop:"
say numbers

# 6. Traversal with while loop
say "Traversal with while loop:"
let idx, val = 0
while idx < len(numbers)
    val = numbers[idx]
    say "  Element at {idx}: {val}"
    idx += 1
end

# 7. Traversal and sum with for loop
let sum = 0
for i in 0..(len(numbers) - 1)
    sum += numbers[i]
end
say "Sum of elements: {sum}"

# 8. Safe bounds check with try/catch
try
    let invalid = numbers[10]
    say invalid
catch err
    say "Caught error safely: {err}"
end
