# Structs and Custom Types in Alya
# Demonstrates struct definitions, named and positional instantiation,
# field access, mutation, functions, and string interpolation

say "=== Structs and Custom Types ==="

# 1. Struct definition
struct Point
    x
    y
end

# 2. Named struct instantiation
let p1 = Point { x: 10, y: 20 }
say "Point 1:"
say p1
say "Point 1 coordinates: ({p1.x}, {p1.y})"

# 3. Field mutation & compound assignment
p1.x = 100
p1.y += 5
say "Mutated Point 1:"
say p1

# 4. Positional constructor instantiation
let p2 = Point(5, 12)
say "Point 2: ({p2.x}, {p2.y})"

# 5. Functions taking and returning structs
function distance_squared(pt)
    return pt.x * pt.x + pt.y * pt.y
end

let d2 = distance_squared(p2)
say "Distance squared of Point 2: {d2}"

function shift(pt, dx, dy)
    pt.x += dx
    pt.y += dy
    return pt
end

let p3 = shift(p2, 10, 20)
say "Shifted Point: ({p3.x}, {p3.y})"

# 6. Struct with multiple types (strings and numbers)
struct Developer
    name
    role
    experience
end

let dev = Developer { name: "Alice", role: "Systems Architect", experience: 8 }
say "{dev.name} is a {dev.role} with {dev.experience} years of experience."
