# Character and String Inspection Tools in Alya

let text = "Alya 2026!"

say "=== Character Indexing ==="
let first = text[0]
say "First char: " + first
let second = char_at(text, 1)
say "Second char: " + second

say "\n=== ASCII Codes ==="
let code_a = ord("A")
say "ASCII of 'A': {code_a}"
let char_b = chr(66)
say "Char from 66: {char_b}"

say "\n=== Character Classification ==="
let d1 = is_digit("5")
say "Is '5' a digit? {d1}"
let d2 = is_digit("a")
say "Is 'a' a digit? {d2}"
let a1 = is_alpha("x")
say "Is 'x' alpha? {a1}"
let a2 = is_alpha("9")
say "Is '9' alpha? {a2}"
let an1 = is_alnum("x")
say "Is 'x' alnum? {an1}"
let an2 = is_alnum("!")
say "Is '!' alnum? {an2}"
let sp1 = is_space(" ")
say "Is ' ' space? {sp1}"
let sp2 = is_space("A")
say "Is 'A' space? {sp2}"
