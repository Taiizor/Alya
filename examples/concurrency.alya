# Alya Example: Concurrency & Tuples
import "std/thread"

# 1. Multiple return values & tuple destructuring
function calculate_stats(a, b)
    let sum = a + b
    let prod = a * b
    return sum, prod
end

let (s, p) = calculate_stats(15, 4)
say "Sum: {s}, Product: {p}"

# Parallel swapping with tuples
let x, y = (10, 20)
x, y = y, x
say "After swap: x={x}, y={y}"

# 2. Concurrency with threads and mutex
function worker_task(pair)
    let id, count = pair
    let tid = thread_id()
    say "Worker #{id} running on OS thread {tid}"
    let total = 0
    for i in 1..count
        total = total + i
    end
    return total
end

let m = mutex_new()
mutex_lock(m)
say "Acquired mutex lock in main thread"
mutex_unlock(m)
mutex_free(m)

# Spawn worker threads concurrently
let t1 = thread_spawn(worker_task, (1, 100))
let t2 = thread_spawn(worker_task, (2, 50))

let res1 = thread_join(t1)
let res2 = thread_join(t2)

say "Worker 1 total (1..100): {res1}"
say "Worker 2 total (1..50): {res2}"
say "Concurrency test completed successfully."
