# mini_compiler.alya
# A self-hosting prototype compiler written entirely in Alya!
# Compiles a subset of Alya (variables, arithmetic, strings, conditionals, loops)
# directly into native x64 Assembly (.s).

# ---------------------------------------------------------------------------
# 0. Token Kind Constants
# ---------------------------------------------------------------------------
# 1:LET, 2:SAY, 3:IF, 4:ELSE, 5:WHILE, 6:END
# 7:NUM, 8:IDENT, 9:STR
# 10:ASSIGN (=)
# 11:PLUS, 12:MINUS, 13:STAR, 14:SLASH
# 15:EQ (==), 16:NEQ (!=), 17:LT (<), 18:LE (<=), 19:GT (>), 20:GE (>=)
# 21:LPAREN, 22:RPAREN
# 99:EOF

# ---------------------------------------------------------------------------
# 1. Lexer / Tokenizer
# ---------------------------------------------------------------------------

function tokenize(src, kinds, vals)
    let n = len(src)
    let i = 0
    let c = ""
    let code = 0
    let num_str = ""
    let id_str = ""
    let str_val = ""
    let ch = ""

    while i < n
        c = src[i]
        code = ord(c)

        # Skip whitespace: space (32), tab (9), CR (13), LF (10)
        if code == 32 || code == 9 || code == 13 || code == 10
            i = i + 1
        elif code == 35
            # Comment '#' - skip until newline
            while i < n
                if ord(src[i]) == 10
                    break
                end
                i = i + 1
            end
        elif is_digit(c)
            num_str = ""
            while i < n
                ch = src[i]
                if !is_digit(ch)
                    break
                end
                num_str = num_str + ch
                i = i + 1
            end
            kinds.push(7) # NUM
            vals.push(num_str)
        elif is_alpha(c)
            id_str = ""
            while i < n
                ch = src[i]
                if !is_alnum(ch) && ord(ch) != 95
                    break
                end
                id_str = id_str + ch
                i = i + 1
            end
            if id_str == "let"
                kinds.push(1)
                vals.push("let")
            elif id_str == "say"
                kinds.push(2)
                vals.push("say")
            elif id_str == "if"
                kinds.push(3)
                vals.push("if")
            elif id_str == "else"
                kinds.push(4)
                vals.push("else")
            elif id_str == "while"
                kinds.push(5)
                vals.push("while")
            elif id_str == "end"
                kinds.push(6)
                vals.push("end")
            else
                kinds.push(8) # IDENT
                vals.push(id_str)
            end
        elif code == 34
            # String literal '"' (ASCII 34)
            i = i + 1
            str_val = ""
            while i < n
                if ord(src[i]) == 34
                    break
                end
                str_val = str_val + src[i]
                i = i + 1
            end
            if i < n
                i = i + 1
            end
            kinds.push(9) # STR
            vals.push(str_val)
        elif code == 61
            # '=' or '=='
            if i + 1 < n
                if ord(src[i + 1]) == 61
                    kinds.push(15) # EQ
                    vals.push("==")
                    i = i + 2
                else
                    kinds.push(10) # ASSIGN
                    vals.push("=")
                    i = i + 1
                end
            else
                kinds.push(10)
                vals.push("=")
                i = i + 1
            end
        elif code == 33
            # '!='
            if i + 1 < n
                if ord(src[i + 1]) == 61
                    kinds.push(16) # NEQ
                    vals.push("!=")
                    i = i + 2
                else
                    i = i + 1
                end
            else
                i = i + 1
            end
        elif code == 60
            # '<' or '<='
            if i + 1 < n
                if ord(src[i + 1]) == 61
                    kinds.push(18) # LE
                    vals.push("<=")
                    i = i + 2
                else
                    kinds.push(17) # LT
                    vals.push("<")
                    i = i + 1
                end
            else
                kinds.push(17)
                vals.push("<")
                i = i + 1
            end
        elif code == 62
            # '>' or '>='
            if i + 1 < n
                if ord(src[i + 1]) == 61
                    kinds.push(20) # GE
                    vals.push(">=")
                    i = i + 2
                else
                    kinds.push(19) # GT
                    vals.push(">")
                    i = i + 1
                end
            else
                kinds.push(19)
                vals.push(">")
                i = i + 1
            end
        elif code == 43
            kinds.push(11) # PLUS
            vals.push("+")
            i = i + 1
        elif code == 45
            kinds.push(12) # MINUS
            vals.push("-")
            i = i + 1
        elif code == 42
            kinds.push(13) # STAR
            vals.push("*")
            i = i + 1
        elif code == 47
            kinds.push(14) # SLASH
            vals.push("/")
            i = i + 1
        elif code == 40
            kinds.push(21) # LPAREN
            vals.push("(")
            i = i + 1
        elif code == 41
            kinds.push(22) # RPAREN
            vals.push(")")
            i = i + 1
        else
            i = i + 1
        end
    end

    kinds.push(99) # EOF
    vals.push("")
end

# ---------------------------------------------------------------------------
# 2. Parser & Code Generator Helpers
# ---------------------------------------------------------------------------

function emit_line(ctx, line)
    let lines = ctx["asm"]
    lines.push(line)
end

function next_label(ctx, prefix)
    let id = ctx["label_id"]
    ctx["label_id"] = id + 1
    return ".L_" + prefix + "_" + "{id}"
end

# ---------------------------------------------------------------------------
# 3. Recursive Descent Expression Parser
# ---------------------------------------------------------------------------

function parse_primary(tk, tv, vars, ctx)
    let pos = ctx["pos"]
    let k = tk[pos]
    let val = ""
    let name = ""
    let off = 0

    if k == 7 # NUM
        val = tv[pos]
        emit_line(ctx, "    mov $" + val + ", %rax")
        ctx["pos"] = pos + 1
    elif k == 8 # IDENT
        name = tv[pos]
        off = vars[name]
        emit_line(ctx, "    mov -" + "{off}" + "(%rbp), %rax")
        ctx["pos"] = pos + 1
    elif k == 21 # LPAREN
        ctx["pos"] = pos + 1
        parse_expr(tk, tv, vars, ctx)
        pos = ctx["pos"]
        if tk[pos] == 22 # RPAREN
            ctx["pos"] = pos + 1
        end
    end
end

function parse_factor(tk, tv, vars, ctx)
    let op = 0
    let pos = 0
    parse_primary(tk, tv, vars, ctx)
    pos = ctx["pos"]
    while tk[pos] == 13 || tk[pos] == 14 # STAR or SLASH
        op = tk[pos]
        emit_line(ctx, "    push %rax")
        ctx["pos"] = pos + 1
        parse_primary(tk, tv, vars, ctx)
        emit_line(ctx, "    mov %rax, %rbx")
        emit_line(ctx, "    pop %rax")
        if op == 13 # STAR
            emit_line(ctx, "    imul %rbx, %rax")
        else
            emit_line(ctx, "    cqo")
            emit_line(ctx, "    idiv %rbx")
        end
        pos = ctx["pos"]
    end
end

function parse_term(tk, tv, vars, ctx)
    let op = 0
    let pos = 0
    parse_factor(tk, tv, vars, ctx)
    pos = ctx["pos"]
    while tk[pos] == 11 || tk[pos] == 12 # PLUS or MINUS
        op = tk[pos]
        emit_line(ctx, "    push %rax")
        ctx["pos"] = pos + 1
        parse_factor(tk, tv, vars, ctx)
        emit_line(ctx, "    mov %rax, %rbx")
        emit_line(ctx, "    pop %rax")
        if op == 11 # PLUS
            emit_line(ctx, "    add %rbx, %rax")
        else
            emit_line(ctx, "    sub %rbx, %rax")
        end
        pos = ctx["pos"]
    end
end

function parse_expr(tk, tv, vars, ctx)
    let k = 0
    let pos = 0
    parse_term(tk, tv, vars, ctx)
    pos = ctx["pos"]
    k = tk[pos]
    if k >= 15 && k <= 20 # EQ, NEQ, LT, LE, GT, GE
        ctx["pos"] = pos + 1
        emit_line(ctx, "    push %rax")
        parse_term(tk, tv, vars, ctx)
        emit_line(ctx, "    mov %rax, %rbx")
        emit_line(ctx, "    pop %rax")
        emit_line(ctx, "    cmp %rbx, %rax")
        if k == 15 # EQ
            emit_line(ctx, "    sete %al")
        elif k == 16 # NEQ
            emit_line(ctx, "    setne %al")
        elif k == 17 # LT
            emit_line(ctx, "    setl %al")
        elif k == 18 # LE
            emit_line(ctx, "    setle %al")
        elif k == 19 # GT
            emit_line(ctx, "    setg %al")
        elif k == 20 # GE
            emit_line(ctx, "    setge %al")
        end
        emit_line(ctx, "    movzbq %al, %rax")
    end
end

# ---------------------------------------------------------------------------
# 4. Statement Parser
# ---------------------------------------------------------------------------

function parse_stmt(tk, tv, vars, ctx)
    let pos = ctx["pos"]
    let k = tk[pos]
    let name = ""
    let top = 0
    let off = 0
    let s_val = ""
    let str_id = 0
    let else_lbl = ""
    let end_lbl = ""
    let start_lbl = ""
    let rlines = [""]

    if k == 1 # LET
        ctx["pos"] = pos + 1
        pos = ctx["pos"]
        name = tv[pos]
        ctx["pos"] = pos + 1
        pos = ctx["pos"]
        if tk[pos] == 10 # ASSIGN
            ctx["pos"] = pos + 1
        end
        parse_expr(tk, tv, vars, ctx)
        top = ctx["stack_top"] + 8
        ctx["stack_top"] = top
        vars[name] = top
        emit_line(ctx, "    mov %rax, -" + "{top}" + "(%rbp)")

    elif k == 8 # IDENT assignment
        name = tv[pos]
        ctx["pos"] = pos + 1
        pos = ctx["pos"]
        if tk[pos] == 10 # ASSIGN
            ctx["pos"] = pos + 1
        end
        parse_expr(tk, tv, vars, ctx)
        off = vars[name]
        emit_line(ctx, "    mov %rax, -" + "{off}" + "(%rbp)")

    elif k == 2 # SAY
        ctx["pos"] = pos + 1
        pos = ctx["pos"]
        if tk[pos] == 9 # STR
            s_val = tv[pos]
            ctx["pos"] = pos + 1
            str_id = ctx["str_count"]
            ctx["str_count"] = str_id + 1
            rlines = ctx["rodata"]
            rlines.push("str_" + "{str_id}" + ":")
            rlines.push("    .string \"" + s_val + "\"")
            emit_line(ctx, "    lea str_" + "{str_id}" + "(%rip), %rdx")
            emit_line(ctx, "    lea fmt_str(%rip), %rcx")
            emit_line(ctx, "    sub $32, %rsp")
            emit_line(ctx, "    call printf")
            emit_line(ctx, "    add $32, %rsp")
        else
            parse_expr(tk, tv, vars, ctx)
            emit_line(ctx, "    mov %rax, %rdx")
            emit_line(ctx, "    lea fmt_int(%rip), %rcx")
            emit_line(ctx, "    sub $32, %rsp")
            emit_line(ctx, "    call printf")
            emit_line(ctx, "    add $32, %rsp")
        end

    elif k == 3 # IF
        ctx["pos"] = pos + 1
        parse_expr(tk, tv, vars, ctx)
        else_lbl = next_label(ctx, "else")
        end_lbl = next_label(ctx, "endif")

        emit_line(ctx, "    test %rax, %rax")
        emit_line(ctx, "    jz " + else_lbl)

        pos = ctx["pos"]
        while tk[pos] != 4 && tk[pos] != 6 && tk[pos] != 99
            parse_stmt(tk, tv, vars, ctx)
            pos = ctx["pos"]
        end

        emit_line(ctx, "    jmp " + end_lbl)
        emit_line(ctx, else_lbl + ":")

        pos = ctx["pos"]
        if tk[pos] == 4 # ELSE
            ctx["pos"] = pos + 1
            pos = ctx["pos"]
            while tk[pos] != 6 && tk[pos] != 99
                parse_stmt(tk, tv, vars, ctx)
                pos = ctx["pos"]
            end
        end

        emit_line(ctx, end_lbl + ":")
        pos = ctx["pos"]
        if tk[pos] == 6 # END
            ctx["pos"] = pos + 1
        end

    elif k == 5 # WHILE
        ctx["pos"] = pos + 1
        start_lbl = next_label(ctx, "loop_start")
        end_lbl = next_label(ctx, "loop_end")

        emit_line(ctx, start_lbl + ":")
        parse_expr(tk, tv, vars, ctx)
        emit_line(ctx, "    test %rax, %rax")
        emit_line(ctx, "    jz " + end_lbl)

        pos = ctx["pos"]
        while tk[pos] != 6 && tk[pos] != 99
            parse_stmt(tk, tv, vars, ctx)
            pos = ctx["pos"]
        end

        emit_line(ctx, "    jmp " + start_lbl)
        emit_line(ctx, end_lbl + ":")

        pos = ctx["pos"]
        if tk[pos] == 6 # END
            ctx["pos"] = pos + 1
        end
    else
        ctx["pos"] = pos + 1
    end
end

# ---------------------------------------------------------------------------
# 5. Full Assembly Generation
# ---------------------------------------------------------------------------

function generate_assembly(ctx)
    let rlines = ctx["rodata"]
    let alines = ctx["asm"]
    let rodata_str = join(rlines, "\n")
    let asm_str = join(alines, "\n")
    let code = ".global main\n.extern printf\n.extern exit\n\n.section .rodata\nfmt_int:\n    .string \"%ld\\n\"\nfmt_str:\n    .string \"%s\\n\"\n"
    code = code + rodata_str + "\n\n.text\nmain:\n"
    code = code + "    push %rbp\n"
    code = code + "    mov %rsp, %rbp\n"
    code = code + "    sub $512, %rsp\n\n"
    code = code + asm_str + "\n\n"
    code = code + "    xor %rax, %rax\n"
    code = code + "    mov %rbp, %rsp\n"
    code = code + "    pop %rbp\n"
    code = code + "    ret\n"
    return code
end

# ---------------------------------------------------------------------------
# 6. Main Compiler Driver
# ---------------------------------------------------------------------------

say "=================================================="
say "      Alya Mini-Compiler (Written in Alya)        "
say "=================================================="

# 1. Determine input source code
let cli_args = args()
let source_code = ""
let arg_path = ""
let kinds = [0]
let vals = [""]
let num_tokens = 0
let vars = map()
let ctx = map()
let final_asm = ""
let out_filename = "mini_output.s"
let cur_p = 0

kinds.pop()
vals.pop()

if len(cli_args) > 0
    arg_path = cli_args[0]
    if file_exists(arg_path)
        say "Loading source from file: {arg_path}"
        source_code = read_file(arg_path)
    end
end

if len(source_code) == 0
    say "No file provided. Compiling embedded demo program:"
    source_code = "let x = 10\nlet y = 25\nlet total = (x + y) * 2\nsay \"=== Execution of Compiled Alya Program ===\"\nsay \"Calculated total:\"\nsay total\nif total > 50\nsay \"Total is greater than 50!\"\nelse\nsay \"Total is 50 or less\"\nend\nlet i = 1\nwhile i <= 3\nsay \"Loop iteration:\"\nsay i\ni = i + 1\nend\n"
end

# 2. Tokenize
say "1. Tokenizing source code..."
tokenize(source_code, kinds, vals)
num_tokens = len(kinds)
say "   Generated {num_tokens} tokens."

# 3. Parse & Generate Assembly
say "2. Parsing and generating x64 Assembly..."
let asm_arr = [""]
let rodata_arr = [""]
asm_arr.pop()
rodata_arr.pop()

ctx["pos"] = 0
ctx["stack_top"] = 0
ctx["label_id"] = 0
ctx["str_count"] = 0
ctx["rodata"] = rodata_arr
ctx["asm"] = asm_arr

cur_p = ctx["pos"]
while kinds[cur_p] != 99 # EOF
    parse_stmt(kinds, vals, vars, ctx)
    cur_p = ctx["pos"]
end

final_asm = generate_assembly(ctx)

# 4. Write output assembly file
say "3. Writing native assembly to {out_filename}..."
write_file(out_filename, final_asm)

say "\n[SUCCESS] Compilation complete!"
say "To produce a native standalone binary, run:"
say "   gcc mini_output.s -o mini_program.exe"
say "   ./mini_program.exe"
say "=================================================="
