// Modern Syntax & Ergonomics in Alya
/*
   Showcasing:
   - Ternary operator (condition ? then_val : else_val)
   - Inline if-expression (if condition then then_val else else_val)
   - Default function parameters
   - Multiline strings ("""...""") and raw strings (`...`)
   - Null coalescing operator (??)
*/

// 1. Ternary Operator & Inline If
say "=== 1. Ternary & Inline If ==="
let score = 85
let grade = score >= 50 ? "Passed" : "Failed"
say "Grade: {grade}"

let x = -10
let label = if x > 0 then "positive" else "non-positive"
say "Label: {label}"

let a = 15
let b = 25
let max_val = a > b ? a : b
say "Max: {max_val}"

// 2. Default Function Parameters
say ""
say "=== 2. Default Parameters ==="
function greet(name, greeting = "Hello", punctuation = "!")
    say "{greeting}, {name}{punctuation}"
end

greet("World")
greet("Alice", "Welcome")
greet("Bob", "Good day", "?")

function power(base, exp = 2)
    let result = 1
    for i in 1..exp
        result *= base
    end
    return result
end

let sq = power(5)
let cube = power(3, 3)
say "Square of 5: {sq}"
say "Cube of 3: {cube}"

// 3. Multiline & Raw Strings
say ""
say "=== 3. Multiline & Raw Strings ==="
let banner = """
*-------------------*
| Welcome to Alya!  |
*-------------------*
"""
say banner

let raw_path = `C:\path\to\config.json`
say "Raw path: {raw_path}"

// 4. Null Coalescing Operator (??)
say ""
say "=== 4. Null Coalescing (??) ==="
let custom_port = null
let port = custom_port ?? 8080
say "Port: {port}"

let user_name = null
let display_name = user_name ?? "Anonymous"
say "User: {display_name}"

let configured_host = "localhost"
let host = configured_host ?? "127.0.0.1"
say "Host: {host}"
