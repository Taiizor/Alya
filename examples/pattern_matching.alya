# Pattern matching in Alya
# Demonstrates when / is / else pattern matching syntax

say "=== HTTP Status Code Resolver ==="
let status = 201

when status
    is 200, 201, 204 then
        say "Success response received"
        say "Status {status}: OK / Created"
    is 400..499
        say "Status {status}: Client Error"
    is >= 500 then
        say "Status {status}: Server Error"
    else
        say "Status {status}: Unknown Status"
end

say "\n=== Priority Level Resolver ==="
let priority = 2

when priority
    is 1 then say "Priority 1: Low"
    is 2 then say "Priority 2: Medium"
    is 3 then say "Priority 3: High"
    is 4 then say "Priority 4: Critical"
    else say "Priority: Custom"
end

