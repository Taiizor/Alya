# Simple calculator in Alya
# Demonstrates functions, arithmetic operations, and string interpolation

function add(a, b)
    return a + b
end

function subtract(a, b)
    return a - b
end

function multiply(a, b)
    return a * b
end

function divide(a, b)
    return a / b
end

function modulo(a, b)
    return a % b
end

say "=== Simple Calculator ==="

let x, y = 15, 7

let res_add = add(x, y)
say "Addition:       {x} + {y} = {res_add}"

let res_sub = subtract(x, y)
say "Subtraction:    {x} - {y} = {res_sub}"

let res_mul = multiply(x, y)
say "Multiplication: {x} * {y} = {res_mul}"

let res_div = divide(x, y)
say "Division:       {x} / {y} = {res_div}"

let res_mod = modulo(x, y)
say "Modulo:         {x} % {y} = {res_mod}"

say "\n=== Complex Expressions ==="
let comp1 = (x + y) * 2
say "({x} + {y}) * 2 = {comp1}"

let comp2 = (x - y) / 2
say "({x} - {y}) / 2 = {comp2}"

let comp3 = 100 / 4 - 5
say "100 / 4 - 5 = {comp3}"

let comp4 = (3 + 5) * (10 - 2)
say "(3 + 5) * (10 - 2) = {comp4}"
