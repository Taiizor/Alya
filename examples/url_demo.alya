import "std/url"

say "=== Alya std/url Demo ==="

# 1. Parsing Full URL
say "\n--- 1. URL Parsing ---"
let raw = "https://developer:token99@api.example.com:8443/v1/search?q=alya+lang&sort=asc#results"
let u = url_parse(raw)
say "Scheme   : " + str_from_ptr(u.url_scheme)
say "Username : " + str_from_ptr(u.url_username)
say "Password : " + str_from_ptr(u.url_password)
say "Host     : " + str_from_ptr(u.url_host)
say "Port     : " + str_from_ptr(u.url_port)
say "Path     : " + str_from_ptr(u.url_path)
say "Query    : " + str_from_ptr(u.url_query)
say "Fragment : " + str_from_ptr(u.url_fragment)

# 2. Origin & Port Helpers
say "\n--- 2. Origin & Port ---"
say "Origin          : " + url_origin(u)
say "Effective Port  : " + url_effective_port(u)
say "Is HTTPS        : " + str(url_is_https(u))

# 3. Query Parameter Management
say "\n--- 3. Query Parameters ---"
let params = url_parse_query(u.url_query)
say "Query 'q'       : " + str_from_ptr(get(params, "q"))
say "Query 'sort'    : " + str_from_ptr(get(params, "sort"))
say "Direct get 'q'  : " + url_get_query_param(raw, "q")
say "Has param 'q'   : " + str(url_has_query_param(raw, "q"))
say "Has param 'page': " + str(url_has_query_param(raw, "page"))

# Add new parameter
let updated = url_set_query_param(raw, "page", "2")
say "Updated 'page'  : " + url_get_query_param(updated, "page")

# Remove parameter
let stripped = url_remove_query_param(updated, "sort")
say "After removing 'sort' has sort: " + str(url_has_query_param(stripped, "sort"))

# 4. Percent-Encoding & Decoding
say "\n--- 4. Percent-Encoding & Decoding ---"
let special_text = "Rock & Roll / 100% #1 @ Alya!"
let encoded = url_encode(special_text)
say "Original : " + special_text
say "Encoded  : " + encoded
let decoded = url_decode(encoded)
say "Decoded  : " + decoded
say "Match    : " + str(special_text == decoded)

# 5. Path Segments & URL Join
say "\n--- 5. Path Segments & Join ---"
let segments = url_path_segments(u)
say "Segments count: " + str(len(segments))
say "Segment 0: " + str_from_ptr(segments[0])
say "Segment 1: " + str_from_ptr(segments[1])

say "Joined URL 1: " + url_join("https://api.example.com/v1/", "/users")
say "Joined URL 2: " + url_join("https://api.example.com/v1", "users")

# 6. Rebuilding & Normalization
say "\n--- 6. Rebuilding & Normalization ---"
let rebuilt = url_format(u)
say "Rebuilt matches raw: " + str(raw == rebuilt)
let normalized = url_normalize("http://example.com:80/path/test?x=1#top")
say "Normalized: " + normalized
