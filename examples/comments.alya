# Comments in Alya

# 1. Shell-style single line comment
let a = 10 # trailing comment

// 2. C-style single line comment
let b = 20 // another trailing comment

/*
   3. Multi-line comment block:
   This entire block is ignored by the compiler.
   You can place notes, documentation, or disable code.
*/
let sum = a /* inline comment */ + b

say "Sum: {sum}"
