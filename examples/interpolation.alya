# String interpolation in Alya
# Demonstrates embedding variables directly inside string literals

let name = "Alice"
let role = "Software Engineer"
let experience, projects = 5, 12

say "=== Developer Profile ==="
say "Name:        {name}"
say "Role:        {role}"
say "Experience:  {experience} years"
say "Projects:    {projects} completed"

say "\nSummary: {name} is a {role} with {experience} years of experience across {projects} projects."
