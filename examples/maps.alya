# Hash Maps and Dictionaries in Alya

let scores = map()
say "=== Hash Map Initialization ==="
let init_len = scores.len()
say "Initial size: {init_len}"

scores["Alice"] = 95
scores["Bob"] = 80
scores["Charlie"] = 70
scores["Bob"] = 88

say "\n=== Accessing Entries ==="
let alice_score = scores["Alice"]
say "Alice score: {alice_score}"
let bob_score = scores["Bob"]
say "Bob score: {bob_score}"
let charlie_score = scores.get("Charlie")
say "Charlie score: {charlie_score}"
let size_after = scores.len()
say "Size after inserts: {size_after}"

say "\n=== Key Membership ==="
let has_alice = scores.contains("Alice")
say "Has Alice? {has_alice}"
let has_david = scores.has("David")
say "Has David? {has_david}"

say "\n=== Removing Entries ==="
let removed = scores.remove("Charlie")
say "Removed Charlie: {removed}"
let has_charlie = scores.contains("Charlie")
say "Has Charlie? {has_charlie}"
let size_rem = scores.len()
say "Size after removal: {size_rem}"

say "\n=== Keys and Values ==="
let all_keys = scores.keys()
let all_vals = scores.values()
let keys_len = all_keys.len()
let vals_len = all_vals.len()
say "Keys count: {keys_len}"
say "Values count: {vals_len}"

let total = 0
for k in scores.keys()
    total += scores[k]
end
say "Total score: {total}"
