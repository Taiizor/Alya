# Alya Standard Library - Thread and Concurrency Module
# Cross-platform OS thread and mutual exclusion synchronization primitives.

# Spawns a new OS-level thread running `func(arg)` concurrently.
# `func` is a function reference.
# `arg` is an optional argument passed to `func` (default: null).
# Returns a thread handle.
function thread_spawn(func, arg = null)
    return __native_thread_spawn(func, arg)
end

# Waits for the thread with handle `h` to complete.
# Returns the return value of the thread's function.
# Cleans up the thread handle and resources.
function thread_join(h)
    return __native_thread_join(h)
end

# Returns the current OS thread ID as an integer.
function thread_id()
    return __native_thread_id()
end

# Suspends the calling thread for `ms` milliseconds.
function thread_sleep(ms)
    sleep(ms)
end

# Creates a new mutex lock.
# Returns a mutex handle.
function mutex_new()
    return __native_mutex_new()
end

# Locks the mutex `m`. Blocks until acquired.
function mutex_lock(m)
    return __native_mutex_lock(m)
end

# Unlocks the mutex `m`.
function mutex_unlock(m)
    return __native_mutex_unlock(m)
end

# Frees the mutex `m` and releases its OS resources.
function mutex_free(m)
    return __native_mutex_free(m)
end

# --- Channel (Thread-Safe FIFO Queue) ---

struct Channel
    q
    lock
    closed
end

# Creates a new thread-safe FIFO channel.
function channel_new()
    return Channel([1], mutex_new(), 0)
end

# Sends a value into the channel. Returns 1 on success, 0 if closed.
function channel_send(ch, val)
    mutex_lock(ch.lock)
    if ch.closed == 1
        mutex_unlock(ch.lock)
        return 0
    end
    ch.q.push(val)
    mutex_unlock(ch.lock)
    return 1
end

# Tries to receive a value without blocking.
# Returns value if present, or null if empty.
function channel_try_recv(ch)
    mutex_lock(ch.lock)
    let head = ch.q[0]
    let total = arr_len(ch.q)
    if head >= total
        mutex_unlock(ch.lock)
        return null
    end
    let val = ch.q[head]
    head += 1
    ch.q[0] = head
    if head > 32 and (head * 2) >= total
        let count = total - head
        let i = 0
        while i < count
            ch.q[i + 1] = ch.q[head + i]
            i += 1
        end
        ch.q[0] = 1
        while arr_len(ch.q) > count + 1
            ch.q.pop()
        end
    end
    mutex_unlock(ch.lock)
    return val
end

# Receives a value from the channel, waiting up to timeout_ms (default: 5000ms).
# Returns the received value, or null on timeout/close.
function channel_recv(ch, timeout_ms = 5000)
    let start = clock_ms()
    while 1
        let val = channel_try_recv(ch)
        if val != null
            return val
        end
        mutex_lock(ch.lock)
        let is_closed = ch.closed
        mutex_unlock(ch.lock)
        if is_closed == 1
            return null
        end
        if timeout_ms > 0 and (clock_ms() - start) >= timeout_ms
            return null
        end
        sleep(2)
    end
    return null
end

# Returns the number of items currently waiting in the channel.
function channel_size(ch)
    mutex_lock(ch.lock)
    let head = ch.q[0]
    let total = arr_len(ch.q)
    let sz = total - head
    if sz < 0
        sz = 0
    end
    mutex_unlock(ch.lock)
    return sz
end

# Closes the channel. No more items can be sent.
function channel_close(ch)
    mutex_lock(ch.lock)
    ch.closed = 1
    mutex_unlock(ch.lock)
    return 1
end

# Closes and releases channel mutex resources.
function channel_free(ch)
    channel_close(ch)
    mutex_free(ch.lock)
end

# --- WaitGroup (Thread-Safe Counter Synchronization) ---

struct WaitGroup
    count
    lock
end

# Creates a new WaitGroup initialized with counter = 0.
function wait_group_new()
    return WaitGroup(0, mutex_new())
end

# Increments the WaitGroup counter by delta (default: 1).
function wait_group_add(wg, delta = 1)
    mutex_lock(wg.lock)
    wg.count += delta
    mutex_unlock(wg.lock)
end

# Decrements the WaitGroup counter by 1.
function wait_group_done(wg)
    mutex_lock(wg.lock)
    if wg.count > 0
        wg.count -= 1
    end
    mutex_unlock(wg.lock)
end

# Blocks until the WaitGroup counter becomes 0 or timeout_ms expires.
# Returns 1 if counter reached 0, 0 if timed out.
function wait_group_wait(wg, timeout_ms = 0)
    let start = clock_ms()
    while 1
        mutex_lock(wg.lock)
        let cur = wg.count
        mutex_unlock(wg.lock)
        if cur <= 0
            return 1
        end
        if timeout_ms > 0 and (clock_ms() - start) >= timeout_ms
            return 0
        end
        sleep(2)
    end
    return 1
end

# Frees the WaitGroup's mutex resources.
function wait_group_free(wg)
    mutex_free(wg.lock)
end
