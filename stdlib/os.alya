# Alya Standard Library - OS Module
# Provides operating system, platform, architecture, environment, and CLI interactions.

# --- Platform & Architecture ---

function os_name()
    return target_os()
end

function arch_name()
    return target_arch()
end

function arch()
    return target_arch()
end

function platform()
    return target_os()
end

function is_windows()
    return target_os() == "windows"
end

function is_linux()
    return target_os() == "linux"
end

function is_macos()
    return target_os() == "macos"
end

function is_posix()
    return target_os() != "windows"
end

# --- Environment Variables ---

function env(key)
    return get_env(key)
end

function env_or(key, default_val)
    let val = get_env(key)
    if len(val) == 0
        return default_val
    end
    return val
end

function has_env(key)
    if len(get_env(key)) > 0
        return 1
    end
    return 0
end

# --- Command Execution & Process ---

function exec(cmd)
    return system_exec(cmd)
end

function exit_process(code)
    exit(code)
end

# --- Command Line Arguments ---

function cli_args()
    return args()
end

function arg_count()
    let a = args()
    return len(a)
end

function arg_at(index, default_val)
    let a = args()
    if index >= 0 and index < len(a)
        return a[index]
    end
    return default_val
end

function has_arg(flag)
    let a = args()
    for arg in a
        if arg == flag
            return 1
        end
    end
    return 0
end

# --- Filesystem & Platform Helpers ---

function temp_dir()
    let t = ""
    if is_windows()
        t = get_env("TEMP")
        if len(t) > 0
            return t
        end
        t = get_env("TMP")
        if len(t) > 0
            return t
        end
        return "C:/Windows/Temp"
    end
    t = get_env("TMPDIR")
    if len(t) > 0
        return t
    end
    return "/tmp"
end

function home_dir()
    let h = ""
    if is_windows()
        h = get_env("USERPROFILE")
        if len(h) > 0
            return h
        end
        let drive = get_env("HOMEDRIVE")
        let p = get_env("HOMEPATH")
        if len(drive) > 0 and len(p) > 0
            return drive + p
        end
        return ""
    end
    return get_env("HOME")
end

function user_name()
    let u = ""
    if is_windows()
        u = get_env("USERNAME")
        if len(u) > 0
            return u
        end
        return ""
    end
    u = get_env("USER")
    if len(u) > 0
        return u
    end
    return get_env("LOGNAME")
end

function hostname()
    let h = ""
    if is_windows()
        h = get_env("COMPUTERNAME")
        if len(h) > 0
            return h
        end
        return ""
    end
    h = get_env("HOSTNAME")
    if len(h) > 0
        return h
    end
    return ""
end

function null_device()
    if is_windows()
        return "NUL"
    end
    return "/dev/null"
end

function path_list_separator()
    if is_windows()
        return ";"
    end
    return ":"
end



