# Alya Standard Library - Math Module
# Provides common mathematical constants, trigonometry, statistics, and utility functions.

let PI = 3.141592653589793
let E = 2.718281828459045
let TAU = 6.283185307179586
let SQRT2 = 1.4142135623730951
let LN2 = 0.6931471805599453
let LN10 = 2.302585092994046
let PHI = 1.618033988749895

function deg_to_rad(deg)
    return deg * (3.141592653589793 / 180.0)
end

function radians(deg)
    return deg * (3.141592653589793 / 180.0)
end

function rad_to_deg(rad)
    return rad * (180.0 / 3.141592653589793)
end

function degrees(rad)
    return rad * (180.0 / 3.141592653589793)
end

function clamp(val, min_val, max_val)
    when val
        is < min_val then return min_val
        is > max_val then return max_val
        else return val
    end
end

function sign(val)
    when val
        is > 0 then return 1
        is < 0 then return -1
        else return 0
    end
end

function is_even(n)
    return n % 2 == 0
end

function is_odd(n)
    return n % 2 != 0
end

function hypot(a, b)
    return sqrt(a * a + b * b)
end

function round(val)
    when val
        is >= 0.0 then return int(val + 0.5)
        else return int(val - 0.5)
    end
end

function floor(val)
    let iv = int(val)
    if val >= 0.0 or float(iv) == val
        return iv
    else
        return iv - 1
    end
end

function ceil(val)
    let iv = int(val)
    if val <= 0.0 or float(iv) == val
        return iv
    else
        return iv + 1
    end
end

function trunc(val)
    return int(val)
end

function _normalize_angle(rad)
    let two_pi = 6.283185307179586
    let pi = 3.141592653589793
    let cycles = int(rad / two_pi)
    let rem = rad - float(cycles) * two_pi
    while rem > pi
        rem = rem - two_pi
    end
    while rem < -pi
        rem = rem + two_pi
    end
    return rem
end

function sin(x)
    let norm = _normalize_angle(x)
    let x2 = norm * norm
    let x3 = norm * x2
    let x5 = x3 * x2
    let x7 = x5 * x2
    let x9 = x7 * x2
    let x11 = x9 * x2
    let x13 = x11 * x2
    return norm - (x3 / 6.0) + (x5 / 120.0) - (x7 / 5040.0) + (x9 / 362880.0) - (x11 / 39916800.0) + (x13 / 6227020800.0)
end

function cos(x)
    return sin(x + 1.5707963267948966)
end

function tan(x)
    return sin(x) / cos(x)
end

function rand_range(min_val, max_val)
    if min_val >= max_val
        return min_val
    end
    let r = rand()
    let span = max_val - min_val + 1
    return min_val + (r % span)
end

function sum(arr)
    let total = 0
    for x in arr
        total += x
    end
    return total
end

function mean(arr)
    let count = len(arr)
    if count == 0
        return 0.0
    end
    return float(sum(arr)) / float(count)
end

function median(arr)
    let count = len(arr)
    if count == 0
        return 0
    end
    let sorted = []
    for x in arr
        sorted.push(x)
    end
    let j = 1
    let key, k = 0
    while j < count
        key = sorted[j]
        k = j - 1
        while k >= 0 and sorted[k] > key
            sorted[k + 1] = sorted[k]
            k -= 1
        end
        sorted[k + 1] = key
        j += 1
    end
    let mid = count / 2
    if count % 2 != 0
        return sorted[mid]
    else
        return (sorted[mid - 1] + sorted[mid]) / 2
    end
end

function variance(arr)
    let count = len(arr)
    if count == 0
        return 0.0
    end
    let m = mean(arr)
    let sum_sq = 0.0
    let diff = 0.0
    for x in arr
        diff = float(x) - m
        sum_sq += diff * diff
    end
    return sum_sq / float(count)
end

function std_dev(arr)
    return sqrt(int(variance(arr)))
end

function lerp(a, b, t)
    return a + (b - a) * t
end

function norm(val, min_val, max_val)
    let span = max_val - min_val
    if span == 0.0 or span == 0
        return 0.0
    end
    return (val - min_val) / span
end

function smoothstep(edge0, edge1, x)
    let span = edge1 - edge0
    if span == 0.0 or span == 0
        return 0.0
    end
    let t = (x - edge0) / span
    if t < 0.0
        return 0.0
    end
    if t > 1.0
        return 1.0
    end
    return t * t * (3.0 - 2.0 * t)
end

function gcd(a, b)
    let x = abs(a)
    let y = abs(b)
    let temp = 0
    while y != 0
        temp = y
        y = x % y
        x = temp
    end
    return x
end

function lcm(a, b)
    if a == 0 or b == 0
        return 0
    end
    let g = gcd(a, b)
    let x = abs(a)
    let y = abs(b)
    return (x / g) * y
end

function factorial(n)
    if n <= 1
        return 1
    end
    let res = 1
    let i = 2
    while i <= n
        res *= i
        i += 1
    end
    return res
end

function is_prime(n)
    if n <= 1
        return 0
    end
    if n <= 3
        return 1
    end
    if n % 2 == 0 or n % 3 == 0
        return 0
    end
    let i = 5
    while i * i <= n
        if n % i == 0 or n % (i + 2) == 0
            return 0
        end
        i += 6
    end
    return 1
end
