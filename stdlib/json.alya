# Alya Standard Library - JSON Helper Module
# Provides serialization and helper utilities for JSON formatting.

function json_escape(s)
    let slen = len(s)
    let res = ""
    let i = 0
    let ch = ""
    let c = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        when c
            is 34 then res += "\\\""
            is 92 then res += "\\\\"
            is 10 then res += "\\n"
            is 13 then res += "\\r"
            is 9  then res += "\\t"
            is 8  then res += "\\b"
            is 12 then res += "\\f"
            else res += ch
        end
        i += 1
    end
    return res
end

function json_string(s)
    return "\"" + json_escape(s) + "\""
end

function json_number(n)
    return str(n)
end

function json_int(n)
    return str(n)
end

function json_float(n)
    let iv = int(n)
    let fv = n - float(iv)
    if fv < 0.0
        fv = -fv
    end
    let frac = int(fv * 100.0 + 0.5)
    if frac == 0
        return str(iv) + ".0"
    end
    while frac % 10 == 0
        frac = frac / 10
    end
    if frac < 10 and fv < 0.1
        return str(iv) + ".0" + str(frac)
    end
    return str(iv) + "." + str(frac)
end

function json_null()
    return "null"
end

function json_bool(b)
    when b
        is 1 then return "true"
        else return "false"
    end
end

function json_kv(key, val)
    return "\"" + json_escape(key) + "\": " + str(val)
end

function json_array(items)
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    let i = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + items[i]
        i += 1
    end
    res = res + "]"
    return res
end

function json_array_of_strings(items)
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    let i = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + json_string(items[i])
        i += 1
    end
    res = res + "]"
    return res
end

function json_array_of_numbers(items)
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    let i = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + str(items[i])
        i += 1
    end
    res = res + "]"
    return res
end

function json_array_of_bools(items)
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    let i = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + json_bool(items[i])
        i += 1
    end
    res = res + "]"
    return res
end

function json_object(m)
    let k = keys(m)
    let v = values(m)
    let count = len(k)
    if count == 0
        return "{}"
    end
    let res = "{"
    let i = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + "\"" + json_escape(k[i]) + "\": " + str(v[i])
        i += 1
    end
    res = res + "}"
    return res
end

function json_map(m)
    return json_object(m)
end

function json_string_map(m)
    let k = keys(m)
    let v = values(m)
    let count = len(k)
    if count == 0
        return "{}"
    end
    let res = "{"
    let i = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + "\"" + json_escape(k[i]) + "\": \"" + json_escape(v[i]) + "\""
        i += 1
    end
    res = res + "}"
    return res
end

function json_pretty(s, indent_spaces)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let pad = ""
    let p = 0
    while p < indent_spaces
        pad += " "
        p += 1
    end
    let res = ""
    let indent_level = 0
    let in_string = 0
    let escape_next = 0
    let i = 0
    let k = 0
    let ch = ""
    while i < slen
        ch = char_at(s, i)
        if escape_next
            res += ch
            escape_next = 0
        else
            if ch == "\\" and in_string
                res += ch
                escape_next = 1
            else
                if ch == "\""
                    in_string = 1 - in_string
                    res += ch
                else
                    if in_string
                        res += ch
                    else
                        if ch == "{" or ch == "["
                            res += ch + "\n"
                            indent_level += 1
                            k = 0
                            while k < indent_level
                                res += pad
                                k += 1
                            end
                        else
                            if ch == "}" or ch == "]"
                                res += "\n"
                                indent_level -= 1
                                k = 0
                                while k < indent_level
                                    res += pad
                                    k += 1
                                end
                                res += ch
                            else
                                if ch == ","
                                    res += ",\n"
                                    k = 0
                                    while k < indent_level
                                        res += pad
                                        k += 1
                                    end
                                else
                                    if ch == ":"
                                        res += ": "
                                    else
                                        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
                                            res += ch
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i += 1
    end
    return res
end

function json_get_string(json_str, key)
    let target = "\"" + key + "\""
    let slen = len(json_str)
    let tlen = len(target)
    let i = 0
    let pos = 0
    let start = 0
    let end_pos = 0
    let escaped = 0
    let c = ""
    while i <= slen - tlen
        if substring(json_str, i, tlen) == target
            pos = i + tlen
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t" or char_at(json_str, pos) == ":")
                if char_at(json_str, pos) == ":"
                    pos += 1
                    break
                end
                pos += 1
            end
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t")
                pos += 1
            end
            if pos < slen and char_at(json_str, pos) == "\""
                start = pos + 1
                end_pos = start
                escaped = 0
                while end_pos < slen
                    c = char_at(json_str, end_pos)
                    if escaped
                        escaped = 0
                    else
                        if c == "\\"
                            escaped = 1
                        else
                            if c == "\""
                                break
                            end
                        end
                    end
                    end_pos += 1
                end
                return substring(json_str, start, end_pos - start)
            end
        end
        i += 1
    end
    return ""
end

function _parse_int(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let res = 0
    let sign = 1
    let i = 0
    let c = 0
    if char_at(s, 0) == "-"
        sign = -1
        i = 1
    end
    while i < slen
        c = ord(char_at(s, i))
        if c >= 48 and c <= 57
            res = res * 10 + (c - 48)
        else
            break
        end
        i += 1
    end
    return res * sign
end

function json_get_number(json_str, key)
    let target = "\"" + key + "\""
    let slen = len(json_str)
    let tlen = len(target)
    let i = 0
    let pos = 0
    let num_str = ""
    let ch = ""
    let c = 0
    let is_num_char = 0
    while i <= slen - tlen
        if substring(json_str, i, tlen) == target
            pos = i + tlen
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t" or char_at(json_str, pos) == ":")
                if char_at(json_str, pos) == ":"
                    pos += 1
                    break
                end
                pos += 1
            end
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t")
                pos += 1
            end
            num_str = ""
            while pos < slen
                ch = char_at(json_str, pos)
                c = ord(ch)
                is_num_char = (c >= 48 and c <= 57) or ch == "-" or ch == "."
                if is_num_char
                    num_str += ch
                else
                    break
                end
                pos += 1
            end
            if len(num_str) > 0
                return _parse_int(num_str)
            end
        end
        i += 1
    end
    return 0
end
