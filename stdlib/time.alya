# Alya Standard Library - Time Module
# Provides time querying and delay routines.

function now()
    return time()
end

function now_ms()
    return clock_ms()
end

function delay(ms)
    return sleep(ms)
end

function sleep_sec(seconds)
    return sleep(seconds * 1000)
end

function elapsed(start_time)
    return time() - start_time
end

function elapsed_ms(start_time_ms)
    return clock_ms() - start_time_ms
end

function seconds(s)
    return s
end

function minutes(m)
    return m * 60
end

function hours(h)
    return h * 3600
end

function days(d)
    return d * 86400
end

function is_leap_year(year)
    if year % 400 == 0
        return 1
    elif year % 100 == 0
        return 0
    end
    return year % 4 == 0
end

function days_in_month(month, year)
    when month
        is 1, 3, 5, 7, 8, 10, 12 then return 31
        is 4, 6, 9, 11 then return 30
        is 2 then
            if is_leap_year(year)
                return 29
            end
            return 28
        else
            return 0
    end
end

function format_duration(sec)
    let h = sec / 3600
    let rem = sec % 3600
    let m = rem / 60
    let s = rem % 60
    let res = ""
    if h > 0
        res = res + str(h) + "h "
    end
    if m > 0 or h > 0
        res = res + str(m) + "m "
    end
    res = res + str(s) + "s"
    return res
end
