# Alya Standard Library - CLI / Argparse Module (std/cli)
# Provides robust command-line interface parsing, flag and option handling,
# subcommand routing, and automated help screen generation.

struct CliOpt
    short_name
    long_name
    opt_desc
    is_flag
    default_val
    required
end

struct CliCmd
    cmd_name
    cmd_desc
end

struct CliParser
    app_name
    description
    version
    opt_defs
    commands
    positionals
end

struct CliResult
    flags
    options
    args
    command
    errors
    help_requested
end

# --- Internal Helpers ---

function _cli_strip_dashes(s)
    let s_str = str_from_ptr(s)
    let slen = len(s_str)
    if slen >= 2 and substring(s_str, 0, 2) == "--"
        return substring(s_str, 2, slen - 2)
    end
    if slen >= 1 and substring(s_str, 0, 1) == "-"
        return substring(s_str, 1, slen - 1)
    end
    return s_str
end

function _cli_find_eq(arg)
    let s_str = str_from_ptr(arg)
    let slen = len(s_str)
    let i = 0
    while i < slen
        if char_at(s_str, i) == "="
            return i
        end
        i += 1
    end
    return -1
end

function _cli_pad_right(s, width)
    let res = str_from_ptr(s)
    let slen = len(res)
    while slen < width
        res = res + " "
        slen += 1
    end
    return res
end

function _cli_parse_flags(flags_str)
    let s = trim(str_from_ptr(flags_str))
    let short_name = ""
    let long_name = ""
    if contains(s, ",")
        let parts = split(s, ",")
        let p0 = trim(str_from_ptr(parts[0]))
        let p1 = trim(str_from_ptr(parts[1]))
        if len(p0) >= 2 and substring(p0, 0, 2) == "--"
            long_name = substring(p0, 2, len(p0) - 2)
        elif len(p0) >= 1 and substring(p0, 0, 1) == "-"
            short_name = substring(p0, 1, len(p0) - 1)
        else
            long_name = p0
        end

        if len(p1) >= 2 and substring(p1, 0, 2) == "--"
            long_name = substring(p1, 2, len(p1) - 2)
        elif len(p1) >= 1 and substring(p1, 0, 1) == "-"
            short_name = substring(p1, 1, len(p1) - 1)
        else
            long_name = p1
        end
    else
        if len(s) >= 2 and substring(s, 0, 2) == "--"
            long_name = substring(s, 2, len(s) - 2)
        elif len(s) >= 1 and substring(s, 0, 1) == "-"
            short_name = substring(s, 1, len(s) - 1)
        else
            long_name = s
        end
    end
    return [short_name, long_name]
end

function _cli_find_opt_by_long(parser, name)
    let n = str_from_ptr(name)
    let count = array_len(parser.opt_defs)
    let i = 0
    while i < count
        let opt = parser.opt_defs[i]
        if str_from_ptr(opt.long_name) == n
            return opt
        end
        i += 1
    end
    return 0
end

function _cli_find_opt_by_short(parser, name)
    let n = str_from_ptr(name)
    let count = array_len(parser.opt_defs)
    let i = 0
    while i < count
        let opt = parser.opt_defs[i]
        if str_from_ptr(opt.short_name) == n
            return opt
        end
        i += 1
    end
    return 0
end

function _cli_is_command(parser, name)
    let n = str_from_ptr(name)
    let count = array_len(parser.commands)
    let i = 0
    while i < count
        let cmd = parser.commands[i]
        if str_from_ptr(cmd.cmd_name) == n
            return 1
        end
        i += 1
    end
    return 0
end

# --- Public Setup API ---

function cli_parser(app_name, description)
    return CliParser(app_name, description, "1.0.0", [], [], [])
end

function cli_set_version(parser, version)
    parser.version = version
    return parser
end

function cli_add_flag(parser, flags_str, description)
    let names = _cli_parse_flags(flags_str)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOpt(s, l, description, 1, "0", 0)
    parser.opt_defs.push(opt)
    return parser
end

function cli_add_option(parser, flags_str, default_val, description)
    let names = _cli_parse_flags(flags_str)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOpt(s, l, description, 0, default_val, 0)
    parser.opt_defs.push(opt)
    return parser
end

function cli_add_required_option(parser, flags_str, description)
    let names = _cli_parse_flags(flags_str)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOpt(s, l, description, 0, "", 1)
    parser.opt_defs.push(opt)
    return parser
end

function cli_add_command(parser, name, description)
    let cmd = CliCmd(name, description)
    parser.commands.push(cmd)
    return parser
end

function cli_add_argument(parser, name, description)
    parser.positionals.push(name)
    return parser
end

# --- Parsing Engine ---

function cli_parse(parser, raw_args)
    let flags = {}
    let options = {}
    let args_list = []
    let errors = []
    let command_name = ""
    let help_req = 0

    # Initialize options and flags with defaults
    let opt_count = array_len(parser.opt_defs)
    let i = 0
    while i < opt_count
        let opt = parser.opt_defs[i]
        let s_name = str_from_ptr(opt.short_name)
        let l_name = str_from_ptr(opt.long_name)
        let def_val = str_from_ptr(opt.default_val)
        if opt.is_flag == 1
            if len(s_name) > 0
                flags[s_name] = 0
            end
            if len(l_name) > 0
                flags[l_name] = 0
            end
        else
            if len(s_name) > 0
                options[s_name] = def_val
            end
            if len(l_name) > 0
                options[l_name] = def_val
            end
        end
        i += 1
    end

    let num_raw = len(raw_args)
    let idx = 0
    let stop_options = 0

    while idx < num_raw
        let arg_str = str_from_ptr(raw_args[idx])
        let arg_len = len(arg_str)

        if stop_options == 1
            args_list.push(arg_str)
            idx += 1
        elif arg_str == "--"
            stop_options = 1
            idx += 1
        elif arg_str == "-h" or arg_str == "--help"
            help_req = 1
            flags["help"] = 1
            flags["h"] = 1
            idx += 1
        elif arg_str == "-V" or arg_str == "--version"
            flags["version"] = 1
            flags["V"] = 1
            idx += 1
        elif arg_len >= 2 and substring(arg_str, 0, 2) == "--"
            let eq_pos = _cli_find_eq(arg_str)
            if eq_pos != -1
                let raw_k = substring(arg_str, 2, eq_pos - 2)
                let val = substring(arg_str, eq_pos + 1, arg_len - (eq_pos + 1))
                options[raw_k] = val
                let opt_match = _cli_find_opt_by_long(parser, raw_k)
                if opt_match != 0
                    let sh = str_from_ptr(opt_match.short_name)
                    if len(sh) > 0
                        options[sh] = val
                    end
                end
            else
                let raw_k = substring(arg_str, 2, arg_len - 2)
                let opt_match = _cli_find_opt_by_long(parser, raw_k)
                if opt_match != 0
                    if opt_match.is_flag == 1
                        flags[raw_k] = 1
                        let sh = str_from_ptr(opt_match.short_name)
                        if len(sh) > 0
                            flags[sh] = 1
                        end
                    else
                        if idx + 1 < num_raw
                            idx += 1
                            let val = str_from_ptr(raw_args[idx])
                            options[raw_k] = val
                            let sh = str_from_ptr(opt_match.short_name)
                            if len(sh) > 0
                                options[sh] = val
                            end
                        else
                            errors.push("Missing value for option: --" + raw_k)
                        end
                    end
                else
                    flags[raw_k] = 1
                end
            end
            idx += 1
        elif arg_len >= 1 and substring(arg_str, 0, 1) == "-" and arg_str != "-"
            let raw_s = substring(arg_str, 1, arg_len - 1)
            let opt_match = _cli_find_opt_by_short(parser, raw_s)
            if opt_match != 0
                if opt_match.is_flag == 1
                    flags[raw_s] = 1
                    let lg = str_from_ptr(opt_match.long_name)
                    if len(lg) > 0
                        flags[lg] = 1
                    end
                else
                    if idx + 1 < num_raw
                        idx += 1
                        let val = str_from_ptr(raw_args[idx])
                        options[raw_s] = val
                        let lg = str_from_ptr(opt_match.long_name)
                        if len(lg) > 0
                            options[lg] = val
                        end
                    else
                        errors.push("Missing value for option: -" + raw_s)
                    end
                end
            else
                flags[raw_s] = 1
            end
            idx += 1
        else
            if len(command_name) == 0 and _cli_is_command(parser, arg_str) == 1
                command_name = arg_str
            else
                args_list.push(arg_str)
            end
            idx += 1
        end
    end

    # Check required options
    let req_i = 0
    while req_i < opt_count
        let req_opt = parser.opt_defs[req_i]
        if req_opt.required == 1
            let l_req = str_from_ptr(req_opt.long_name)
            let s_req = str_from_ptr(req_opt.short_name)
            let has_val = 0
            if len(l_req) > 0 and has(options, l_req) == 1
                let v = str_from_ptr(get(options, l_req))
                if len(v) > 0
                    has_val = 1
                end
            end
            if len(s_req) > 0 and has(options, s_req) == 1
                let v = str_from_ptr(get(options, s_req))
                if len(v) > 0
                    has_val = 1
                end
            end
            if has_val == 0
                errors.push("Missing required option: --" + l_req)
            end
        end
        req_i += 1
    end

    return CliResult(flags, options, args_list, command_name, errors, help_req)
end

function cli_parse_args(parser)
    return cli_parse(parser, args())
end

# --- Query / Accessor API ---

function cli_get_flag(result, name)
    let clean = _cli_strip_dashes(name)
    if has(result.flags, clean) == 1
        return get(result.flags, clean)
    end
    return 0
end

function cli_get_option(result, name, default_val)
    let clean = _cli_strip_dashes(name)
    if has(result.options, clean) == 1
        return get(result.options, clean)
    end
    return default_val
end

function cli_get_arg(result, idx, default_val)
    let r_args = result.args
    if idx >= 0 and idx < len(r_args)
        return str_from_ptr(r_args[idx])
    end
    return default_val
end

function cli_get_args(result)
    return result.args
end

function cli_get_command(result)
    return str_from_ptr(result.command)
end

function cli_has_command(result, name)
    let n = str_from_ptr(name)
    let c = str_from_ptr(result.command)
    if c == n
        return 1
    end
    return 0
end

function cli_has_errors(result)
    let errs = result.errors
    if len(errs) > 0
        return 1
    end
    return 0
end

function cli_get_errors(result)
    return result.errors
end

function cli_help_requested(result)
    return result.help_requested
end

# --- Help Text Formatter ---

function cli_help(parser)
    let out = "Usage: " + str_from_ptr(parser.app_name)
    if array_len(parser.commands) > 0
        out = out + " [COMMAND]"
    end
    out = out + " [OPTIONS]"
    if array_len(parser.positionals) > 0
        out = out + " [ARGS]"
    end
    out = out + "\n\n"

    let desc = str_from_ptr(parser.description)
    if len(desc) > 0
        out = out + desc + "\n\n"
    end

    if array_len(parser.commands) > 0
        out = out + "Commands:\n"
        let num_cmd = array_len(parser.commands)
        let i = 0
        while i < num_cmd
            let cmd = parser.commands[i]
            let cname = str_from_ptr(cmd.cmd_name)
            let cdesc = str_from_ptr(cmd.cmd_desc)
            out = out + "  " + _cli_pad_right(cname, 14) + " " + cdesc + "\n"
            i += 1
        end
        out = out + "\n"
    end

    out = out + "Options:\n"
    let num_opts = array_len(parser.opt_defs)
    let j = 0
    while j < num_opts
        let opt = parser.opt_defs[j]
        let s = str_from_ptr(opt.short_name)
        let l = str_from_ptr(opt.long_name)
        let d = str_from_ptr(opt.opt_desc)
        let def = str_from_ptr(opt.default_val)
        let opt_label = ""
        if len(s) > 0 and len(l) > 0
            opt_label = "-" + s + ", --" + l
        elif len(l) > 0
            opt_label = "    --" + l
        else
            opt_label = "-" + s
        end
        if opt.is_flag == 0
            opt_label = opt_label + " <value>"
        end

        let line = "  " + _cli_pad_right(opt_label, 26) + " " + d
        if opt.is_flag == 0 and len(def) > 0
            line = line + " (default: " + def + ")"
        end
        out = out + line + "\n"
        j += 1
    end
    out = out + "  -h, --help                 Show help information\n"
    out = out + "  -V, --version              Show version information\n"
    return out
end

function cli_print_help(parser)
    say cli_help(parser)
end

# --- Direct Convenience Helpers (one-liners without parser) ---

function cli_raw_args()
    return args()
end

function cli_has_flag(flag_name)
    let raw = args()
    let clean = _cli_strip_dashes(flag_name)
    let target_long = "--" + clean
    let target_short = "-" + clean
    let count = len(raw)
    let i = 0
    while i < count
        let arg = str_from_ptr(raw[i])
        if arg == target_long or arg == target_short
            return 1
        end
        i += 1
    end
    return 0
end

function cli_get_opt(opt_name, default_val)
    let raw = args()
    let clean = _cli_strip_dashes(opt_name)
    let target_long = "--" + clean
    let target_short = "-" + clean
    let prefix = target_long + "="
    let prefix_len = len(prefix)
    let count = len(raw)
    let i = 0
    while i < count
        let arg = str_from_ptr(raw[i])
        let arg_len = len(arg)
        if arg_len >= prefix_len and substring(arg, 0, prefix_len) == prefix
            return substring(arg, prefix_len, arg_len - prefix_len)
        end
        if arg == target_long or arg == target_short
            if i + 1 < count
                return str_from_ptr(raw[i + 1])
            end
        end
        i += 1
    end
    return default_val
end

function cli_get_positional(idx, default_val)
    let raw = args()
    let count = len(raw)
    let pos_idx = 0
    let i = 0
    while i < count
        let arg = str_from_ptr(raw[i])
        let arg_len = len(arg)
        if arg_len > 0 and substring(arg, 0, 1) != "-"
            if pos_idx == idx
                return arg
            end
            pos_idx += 1
        end
        i += 1
    end
    return default_val
end
