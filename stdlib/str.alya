# Alya Standard Library - String Module
# Provides advanced string manipulation and inspection functions.

function is_empty(s)
    return len(s) == 0
end

function starts_with(s, prefix)
    let plen, slen = len(prefix), len(s)
    if plen > slen
        return 0
    end
    if plen == 0
        return 1
    end
    return substring(s, 0, plen) == prefix
end

function ends_with(s, suffix)
    let slen, suflen = len(s), len(suffix)
    if suflen > slen
        return 0
    end
    if suflen == 0
        return 1
    end
    return substring(s, slen - suflen, suflen) == suffix
end

function replace(s, old, new_s)
    let slen, olen = len(s), len(old)
    if olen == 0
        return s
    end
    let res = ""
    let i = 0
    while i < slen
        if i + olen <= slen and substring(s, i, olen) == old
            res += new_s
            i += olen
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

function str_repeat(s, count)
    let res = ""
    let i = 0
    while i < count
        res += s
        i += 1
    end
    return res
end

function pad_left(s, total_len, pad_char)
    let slen = len(s)
    if slen >= total_len
        return s
    end
    let diff = total_len - slen
    let padding = str_repeat(pad_char, diff)
    return padding + s
end

function pad_right(s, total_len, pad_char)
    let slen = len(s)
    if slen >= total_len
        return s
    end
    let diff = total_len - slen
    let padding = str_repeat(pad_char, diff)
    return s + padding
end

function capitalize(s)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let first = upper(substring(s, 0, 1))
    if slen == 1
        return first
    end
    let rest = lower(substring(s, 1, slen - 1))
    return first + rest
end

function lines(s)
    let res = []
    let slen = len(s)
    if slen == 0
        return res
    end
    let current, ch = ""
    let i = 0
    while i < slen
        ch = char_at(s, i)
        when ch
            is "\r" then
                if i + 1 < slen and char_at(s, i + 1) == "\n"
                    i += 1
                end
                res.push(current)
                current = ""
            is "\n" then
                res.push(current)
                current = ""
            else
                current += ch
        end
        i += 1
    end
    res.push(current)
    return res
end

function count_matches(s, sub)
    let slen, sublen = len(s), len(sub)
    if sublen == 0 or slen == 0 or sublen > slen
        return 0
    end
    let count = 0
    let i = 0
    while i <= slen - sublen
        if substring(s, i, sublen) == sub
            count += 1
            i += sublen
        else
            i += 1
        end
    end
    return count
end