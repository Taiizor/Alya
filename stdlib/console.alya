# Alya Standard Library - Console Module
# Provides cross-platform console encoding, code page management, and terminal control.

# --- Encoding & Code Pages ---

function console_set_output_cp(cp)
    return set_console_output_cp(cp)
end

function console_set_input_cp(cp)
    return set_console_input_cp(cp)
end

function console_output_cp()
    return get_console_output_cp()
end

function console_input_cp()
    return get_console_input_cp()
end

function console_utf8()
    set_console_output_cp(65001)
    set_console_input_cp(65001)
    enable_virtual_terminal()
    return 1
end

function set_output_encoding(encoding_name)
    return console_utf8()
end

function get_output_encoding()
    let cp = console_output_cp()
    if cp == 65001
        return "UTF-8"
    elif cp == 1254 or cp == 857
        return "Turkish (Windows)"
    elif cp == 1252 or cp == 437
        return "Western (Windows)"
    end
    return "CP" + str(cp)
end

# --- Terminal Display & Cursor Control ---

function console_enable_ansi()
    return enable_virtual_terminal()
end

function console_clear()
    return clear_console()
end

function console_title(title)
    return set_console_title(title)
end

function console_beep()
    return beep_console()
end

function console_cursor_to(row, col)
    say "\e[" + str(row) + ";" + str(col) + "H"
end

function console_cursor_hide()
    say "\e[?25l"
end

function console_cursor_show()
    say "\e[?25h"
end

# --- UI & TUI Components ---

# Formats a progress bar string: "[==========>          ] 50%"
function console_progress_bar(current, total, width = 20)
    if total <= 0
        total = 1
    end
    if current < 0
        current = 0
    end
    if current > total
        current = total
    end
    if width <= 0
        width = 20
    end
    let percent = (current * 100) / total
    let filled = (current * width) / total
    let bar = "["
    let i = 0
    while i < filled
        bar += "="
        i += 1
    end
    if filled < width
        bar += ">"
        i += 1
    end
    while i < width
        bar += " "
        i += 1
    end
    bar += "] " + str(percent) + "%"
    return bar
end

# Returns a spinner character: '|', '/', '-', '\' cycling with step.
function console_spinner_char(step)
    let idx = step % 4
    if idx == 0
        return "|"
    elif idx == 1
        return "/"
    elif idx == 2
        return "-"
    end
    return "\\"
end

# Prompts the user with message and reads a full line of text from stdin.
function console_prompt(prompt_text)
    return ask(prompt_text)
end

# Asks user a yes/no question. Returns 1 for yes, 0 for no.
function console_confirm(prompt_text, default_yes = 1)
    let suffix = " (Y/n): "
    if default_yes == 0
        suffix = " (y/N): "
    end
    let resp = lower(trim(ask(prompt_text + suffix)))
    if len(resp) == 0
        return default_yes
    end
    if resp == "y" or resp == "yes" or resp == "1" or resp == "e" or resp == "evet"
        return 1
    end
    return 0
end

# Prints a formatted ASCII table with headers and data rows.
function console_table(headers, rows)
    let col_count = arr_len(headers)
    if col_count == 0
        return 0
    end
    let widths = []
    let i = 0
    while i < col_count
        widths.push(len(headers[i]))
        i += 1
    end
    let r_idx = 0
    let row_count = arr_len(rows)
    while r_idx < row_count
        let row = rows[r_idx]
        let c_idx = 0
        while c_idx < col_count and c_idx < arr_len(row)
            let cell_len = len(row[c_idx])
            if cell_len > widths[c_idx]
                widths[c_idx] = cell_len
            end
            c_idx += 1
        end
        r_idx += 1
    end

    # Format divider line
    let div = "+"
    i = 0
    while i < col_count
        let w = widths[i] + 2
        let j = 0
        while j < w
            div += "-"
            j += 1
        end
        div += "+"
        i += 1
    end

    # Format header row
    let header_line = "|"
    i = 0
    while i < col_count
        let val_str = headers[i]
        header_line += " " + val_str
        let pad = widths[i] - len(val_str) + 1
        let j = 0
        while j < pad
            header_line += " "
            j += 1
        end
        header_line += "|"
        i += 1
    end

    say div
    say header_line
    say div

    # Format data rows
    r_idx = 0
    while r_idx < row_count
        let row = rows[r_idx]
        let row_line = "|"
        let c_idx = 0
        while c_idx < col_count
            let val_str = ""
            if c_idx < arr_len(row)
                val_str = row[c_idx]
            end
            row_line += " " + val_str
            let pad = widths[c_idx] - len(val_str) + 1
            let j = 0
            while j < pad
                row_line += " "
                j += 1
            end
            row_line += "|"
            c_idx += 1
        end
        say row_line
        r_idx += 1
    end
    say div
    return 1
end

